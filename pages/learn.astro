---
import Arrow from '../components/Arrow.astro';
import ShareLinks from '../components/ShareLinks.astro';
import Base from '../layouts/Base.astro';
import Fold from '../components/Fold.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import glossary from '../data/glossary.json';
import quotes from '../data/quotes.json';
import resources from '../data/resources.json';
import { href } from '../lib/paths';

// Where democracy reaches today, and where democratic socialists want it to go.
const reach = [
  { label: 'Government', note: 'Everyone already gets a say.', now: true },
  { label: 'The workplace', note: 'Why should democracy stop at the door?', now: false },
  { label: 'The things we all depend on', note: 'Like health care, housing, and energy.', now: false },
];

// What it means in practice. Icons are simple line drawings on a 48 × 48 grid.
const practice = [
  { title: 'Health care for everyone', icon: 'M24 40s-14-8.5-14-18a8 8 0 0 1 14-5.3A8 8 0 0 1 38 22c0 9.5-14 18-14 18z M24 20v10 M19 25h10' },
  { title: 'Homes people can afford', icon: 'M8 22 24 9l16 13 M12 19v20h24V19 M20 39V28h8v11' },
  { title: 'Strong unions', icon: 'M16 18a5 5 0 1 0 0-.1z M32 18a5 5 0 1 0 0-.1z M7 39c0-6 4-10 9-10s9 4 9 10 M23 39c0-6 4-10 9-10s9 4 9 10' },
  { title: 'Public services that are actually public', icon: 'M6 16 24 7l18 9z M10 20v15 M19 20v15 M29 20v15 M38 20v15 M6 40h36' },
];

const freedoms = ['Free speech', 'Free elections', 'The right to organize'];

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Glossary groups, in display order. Each term in glossary.json names its group
// in `category`. A term with an unknown category fails the build.
const groupInfo = [
  { id: 'ideas', title: 'The big ideas', blurb: 'The core ideas behind what we do and why.' },
  { id: 'organizing', title: 'Workers and organizing', blurb: 'How working people build power together.' },
  { id: 'policy', title: "What we're fighting for", blurb: 'Big policy ideas you will hear about.' },
  { id: 'dsa', title: 'How DSA works', blurb: 'The words for how our organization runs.' },
];
for (const t of glossary) {
  if (!groupInfo.some((g) => g.id === t.category)) {
    throw new Error(`glossary.json: "${t.term}" has unknown category "${t.category}". Use one of: ${groupInfo.map((g) => g.id).join(', ')}`);
  }
}
const groups = groupInfo.map((g) => ({ ...g, terms: glossary.filter((t) => t.category === g.id) }));

// The longest quote gets the big spot.
const [featured, ...otherQuotes] = [...quotes].sort((a, b) => b.text.length - a.text.length);
---
<Base title="Learn the basics" description="What democratic socialism means, a plain-language glossary, and where to read more.">
  <PageHeader eyebrow="Learn" title="The basics, in plain language." lede="What democratic socialism means, the words you'll hear at meetings, and where to read more. No homework required." />

  <!-- The big idea -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="The big idea" title="What is democratic socialism?" />
      <p class="mt-8 max-w-4xl font-display font-bold text-2xl sm:text-3xl lg:text-4xl leading-snug tracking-tight">
        Democratic socialists believe that both the economy and society should be run democratically, <span class="text-red-dark">to meet human needs rather than to make profits for a few.</span>
      </p>

      <h3 class="mt-14 font-display font-extrabold text-xl">Democracy, all the way through</h3>
      <ol class="mt-5 grid md:grid-cols-3 gap-4 md:gap-0">
        {reach.map((r, i) => (
          <li class="relative flex md:block">
            <div class:list={[
              'flex-1 h-full rounded-xl p-6',
              i < reach.length - 1 && 'md:mr-8',
              r.now ? 'bg-black text-white' : 'border-2 border-dashed border-red bg-red-4/30',
            ]}>
              <span class:list={['text-xs font-semibold tracking-[0.18em] uppercase', r.now ? 'text-red-2' : 'text-red-dark']}>
                {r.now ? 'Today' : 'Next'}
              </span>
              <p class="mt-1 font-display font-black text-2xl leading-tight">{r.label}</p>
              <p class:list={['mt-2 leading-relaxed', r.now ? 'text-white/80' : 'text-black-1']}>{r.note}</p>
            </div>
            {i < reach.length - 1 && (
              <span class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 w-8 justify-center text-red" aria-hidden="true">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 6l6 6-6 6M5 12h14" /></svg>
              </span>
            )}
          </li>
        ))}
      </ol>
      <p class="mt-8 max-w-3xl text-lg leading-relaxed">
        Most of us already believe in democracy when it comes to government: everyone gets a say. Democratic socialism asks why that should stop at the workplace door, or at the things we all depend on.
        When a handful of owners make those decisions for profit, the rest of us live with the results. <strong>We think the people who do the work and live in the community should decide.</strong>
      </p>
    </div>
  </section>

  <!-- In practice -->
  <section class="py-14 sm:py-20 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="In practice" title="What we fight for." />
      <ul class="tray mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {practice.map((p) => (
          <li class="bg-white rounded-xl p-6 ring-1 ring-black/10 border-t-4 border-red">
            <span class="w-16 h-16 rounded-full bg-red-dark text-white flex items-center justify-center" aria-hidden="true">
              <svg class="w-9 h-9" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
            </span>
            <p class="mt-5 font-display font-extrabold text-xl leading-tight">{p.title}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-3xl text-lg leading-relaxed">
        It also means building organizations, like this one, where ordinary people practice running things together.
      </p>
    </div>
  </section>

  <!-- More democracy, plus quotes -->
  <section class="py-14 sm:py-20 bg-black text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <p class="font-semibold tracking-[0.18em] uppercase text-xs text-red-2">What it doesn't mean</p>
          <h2 class="mt-3 font-display font-black text-4xl sm:text-5xl leading-[1.02]">More democracy,<br />not less.</h2>
          <p class="mt-5 text-lg text-white/80 leading-relaxed max-w-xl">It does not mean giving up freedoms. These are the foundation:</p>
        </div>
        <ul class="lg:col-span-5 flex flex-wrap gap-3">
          {freedoms.map((f) => (
            <li class="px-5 py-3 rounded-full bg-red-dark font-display font-bold text-lg">{f}</li>
          ))}
        </ul>
      </div>

      <div class="mt-16 border-t border-white/15 pt-14 grid lg:grid-cols-12 gap-10">
        <figure class="lg:col-span-7">
          <span class="block font-display font-black text-red text-8xl leading-[0.5] h-10" aria-hidden="true">“</span>
          <blockquote class="font-display font-extrabold text-2xl sm:text-3xl leading-snug">{featured.text}</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span class="h-1 w-10 bg-red" aria-hidden="true"></span>
            <span><span class="font-semibold">{featured.who}</span> <span class="text-white/60">· {featured.where}</span></span>
          </figcaption>
        </figure>
        <div class="lg:col-span-5 space-y-8">
          {otherQuotes.map((q) => (
            <figure class="pl-5 border-l-4 border-red">
              <blockquote class="font-display font-bold text-xl leading-snug">“{q.text}”</blockquote>
              <figcaption class="mt-3 text-sm"><span class="font-semibold">{q.who}</span> <span class="text-white/60">· {q.where}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Glossary -->
  <section id="glossary" class="py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Glossary" title="Words you'll hear at meetings." lede="Nobody is born knowing these. Ask at any meeting and someone will happily explain." />
        <p class="flex items-baseline gap-3">
          <span class="font-display font-black text-6xl text-red leading-none">{glossary.length}</span>
          <span class="font-display font-bold text-lg leading-tight">words in<br />{groups.length} groups</span>
        </p>
      </div>

      <!-- Index, like the back of a book -->
      <nav id="glossary-index" aria-label="Glossary index" class="hidden md:block mt-10 scroll-mt-24 rounded-2xl bg-black text-white p-6 sm:p-8">
        <p class="font-semibold tracking-[0.18em] uppercase text-xs text-red-2">Jump to a word</p>
        <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {groups.map((g, i) => (
            <div>
              <a href={`#group-${g.id}`} class="group flex items-baseline gap-2 hover:text-red-2">
                <span class="font-display font-black text-red text-sm">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display font-extrabold text-lg leading-tight group-hover:underline underline-offset-4">{g.title}</span>
              </a>
              <ul class="mt-3 space-y-1.5 border-l border-white/15 pl-4">
                {g.terms.map((t) => (
                  <li><a href={`#term-${slug(t.term)}`} class="text-white/75 hover:text-white hover:underline underline-offset-4">{t.term}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>

      <!-- One block per group, dictionary style -->
      {groups.map((g, i) => (
        <div id={`group-${g.id}`} class="mt-8 sm:mt-20 scroll-mt-24 grid lg:grid-cols-12 gap-4 lg:gap-12 border-t-4 border-black pt-6 sm:pt-8">
          <header class="lg:col-span-4">
            <div class="lg:sticky lg:top-24">
              <span class="block font-display font-black text-5xl sm:text-8xl leading-none outline-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-display font-black text-3xl leading-tight">{g.title}</h3>
              <p class="mt-2 text-black-2 leading-relaxed">{g.blurb}</p>
              <a href="#glossary-index" class="hidden md:inline-block mt-4 text-sm font-semibold text-red-dark hover:text-red underline underline-offset-4">↑ Back to the index</a>
            </div>
          </header>
          <div class="lg:col-span-8"><Fold id={`words-${g.id}`} label={`See the ${g.terms.length} words`}>
          <dl class="divide-y divide-black/10">
            {g.terms.map((t) => (
              <div id={`term-${slug(t.term)}`} class="term scroll-mt-24 relative -ml-4 pl-4 grid sm:grid-cols-[13rem_1fr] gap-x-8 gap-y-2 py-6">
                <dt class="font-display font-black text-2xl leading-tight">{t.term}</dt>
                <dd class="text-lg text-black-1 leading-relaxed">{t.definition}</dd>
              </div>
            ))}
          </dl>
          </Fold></div>
        </div>
      ))}
    </div>
  </section>

  <!-- Reading -->
  <section id="reading" class="py-14 sm:py-20 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Keep going" title="Where to read more." />
      <ul class="tray tray-narrow mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {resources.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener" class="group h-full flex flex-col p-6 bg-white rounded-xl ring-1 ring-black/10 hover:bg-red-dark hover:ring-red-dark hover:text-white transition-colors">
              <span class="font-display font-extrabold text-xl">{r.label}</span>
              <span class="mt-2 flex-1 text-sm text-black-2 group-hover:text-white/90 leading-relaxed">{r.blurb}</span>
              <span class="mt-5 w-10 h-10 rounded-full bg-red group-hover:bg-white text-white group-hover:text-red flex items-center justify-center transition-colors" aria-hidden="true">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-8 rounded-xl bg-white ring-1 ring-black/10 p-6 sm:flex sm:items-center sm:gap-6">
        <p class="flex-1 leading-relaxed">
          <span class="font-display font-extrabold text-lg">Sharing this with someone?</span>
          <span class="text-black-2"> There's a printable "What is democratic socialism?" handout and a matching social media post, under <em>Signs &amp; handouts</em> in our flyer library.</span>
        </p>
        <a href={href('/member-resources/printables/')} class="mt-4 sm:mt-0 inline-flex shrink-0 items-center gap-2 px-5 py-3 bg-black hover:bg-red text-white font-semibold rounded-button transition-colors">Flyers and printables <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-red-dark text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-black text-3xl sm:text-4xl">Learn with other people.</h2>
      <p class="mt-4 text-lg leading-relaxed text-white/90">Our Political Education working group runs reading groups and discussions.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={href('/events/')} class="px-6 py-3 bg-white text-red-dark hover:bg-black hover:text-white rounded-button font-semibold transition-colors">Check the calendar</a>
        <a href={href('/about/#branches-and-groups')} class="px-6 py-3 ring-2 ring-white/60 hover:ring-white hover:bg-white/10 rounded-button font-semibold transition-colors">Read about our working groups</a>
      </div>
    </div>
  </section>
  <ShareLinks title="The basics of democratic socialism" />
</Base>

<style>
  /* Outlined group numbers in the glossary. */
  .outline-num {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-red);
  }
  /* The entry you jumped to gets a red bar and a tint. */
  .term:target {
    background: color-mix(in srgb, var(--color-red-4) 45%, transparent);
  }
  .term:target::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--color-red);
  }
</style>
