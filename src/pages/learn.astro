---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import glossary from '../data/glossary.json';
import quotes from '../data/quotes.json';
import resources from '../data/resources.json';
import { href } from '../lib/paths';
---
<Base title="Learn the basics" description="What democratic socialism means, a plain-language glossary, and where to read more.">
  <PageHeader eyebrow="Learn" title="The basics, in plain language." lede="What democratic socialism means, the words you'll hear at meetings, and where to read more. No homework required." />

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="The big idea" title="What is democratic socialism?" />
        <div class="mt-6 space-y-5 text-lg leading-relaxed">
          <p>
            Democratic socialists believe that both the economy and society should be run democratically, to meet human needs rather than to make profits for a few.
          </p>
          <p>
            Most of us already believe in democracy when it comes to government: everyone gets a say. Democratic socialism asks why that should stop at the workplace door, or at the things we all depend on, like health care, housing, and energy.
            When a handful of owners make those decisions for profit, the rest of us live with the results. We think the people who do the work and live in the community should decide.
          </p>
          <p>
            In practice that means fighting for things like health care for everyone, homes people can afford, strong unions, and public services that are actually public. It also means building organizations, like this one, where ordinary people practice running things together.
          </p>
          <p>
            It does not mean giving up freedoms. Free speech, free elections, and the right to organize are the foundation. We want more democracy, not less.
          </p>
        </div>
      </div>
      <div class="lg:col-span-5 space-y-5">
        {quotes.map((q) => (
          <figure class="rounded-xl bg-mist p-6 border-l-4 border-red">
            <blockquote class="font-display font-bold text-lg leading-snug">“{q.text}”</blockquote>
            <figcaption class="mt-3 text-sm text-black-2"><span class="font-semibold text-black">{q.who}</span> · {q.where}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="glossary" class="py-12 sm:py-16 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Glossary" title="Words you'll hear at meetings." lede="Nobody is born knowing these. Ask at any meeting and someone will happily explain." />
      <dl class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {glossary.map((g) => (
          <div class="bg-white rounded-xl p-5 ring-1 ring-black/10">
            <dt class="font-display font-extrabold text-lg">{g.term}</dt>
            <dd class="mt-1.5 text-black-2 leading-relaxed">{g.definition}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="reading" class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Keep going" title="Where to read more." />
      <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {resources.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener" class="group block h-full p-5 bg-mist rounded-lg hover:bg-red hover:text-white transition-colors">
              <span class="font-display font-bold text-lg">{r.label} <span aria-hidden="true">↗</span></span>
              <p class="mt-1 text-sm text-black-2 group-hover:text-white leading-relaxed">{r.blurb}</p>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-lg">
        Our Political Education working group runs reading groups and discussions. <a href={href('/events/')} class="font-semibold text-red-dark hover:text-red underline underline-offset-4">Check the calendar</a> or <a href={href('/about/#branches-and-groups')} class="font-semibold text-red-dark hover:text-red underline underline-offset-4">read about our working groups</a>.
      </p>
    </div>
  </section>
</Base>
