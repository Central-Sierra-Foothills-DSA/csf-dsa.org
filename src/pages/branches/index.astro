---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BranchMap from '../../components/BranchMap.astro';
import BranchCard from '../../components/BranchCard.astro';
import site from '../../data/site.json';
import towns from '../../data/towns.json';
import { milesBetween } from '../../lib/geo';
import { href } from '../../lib/paths';

const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);

// Closest branch for each town: prefer a branch in the town's own county, then
// pick the nearest meeting place by straight-line distance.
const FAR_MILES = 30;
const placed = towns.map((t) => {
  const inCounty = branches.filter((b) => b.data.counties.includes(t.county));
  const pool = inCounty.length ? inCounty : branches;
  const ranked = pool.map((b) => ({ b, miles: milesBetween(t, b.data) })).sort((x, y) => x.miles - y.miles);
  return { town: t, branch: ranked[0].b, miles: ranked[0].miles };
});
const near = (id: string) => placed.filter((p) => p.branch.id === id && p.miles <= FAR_MILES).sort((a, b) => a.town.name.localeCompare(b.town.name));
const far = placed.filter((p) => p.miles > FAR_MILES).sort((a, b) => a.town.name.localeCompare(b.town.name));
---
<Base title="Branches" description="Find the Central Sierra Foothills DSA branch closest to you: Grass Valley / Nevada City, Auburn, Placerville, or Roseville.">
  <PageHeader eyebrow="Branches" title="Find your branch." lede="Our chapter stretches from Roseville to Lake Tahoe, so we organize locally. Each branch meets monthly and runs its own projects. Go to whichever suits you. Every branch is open to everyone." />

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <div class="lg:sticky lg:top-24"><BranchMap /></div>
        <div class="grid gap-5">
          {branches.map((b, i) => <BranchCard branch={b} number={i + 1} />)}
        </div>
      </div>
    </div>
  </section>

  <section id="closest" class="py-12 sm:py-16 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Closest branch" title="Look up your town." lede="Find your town below to see which branch meets nearest to you. This is only a suggestion based on distance." />
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {branches.map((b, i) => (
          <div class="bg-white rounded-xl p-5 ring-1 ring-black/10">
            <h3 class="font-display font-extrabold text-lg leading-tight flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red text-white text-xs font-black" aria-hidden="true">{i + 1}</span>
              <a href={href(`/branches/${b.id}/`)} class="hover:text-red-dark">{b.data.name}</a>
            </h3>
            <ul class="mt-3 text-sm text-black-2 leading-relaxed columns-2 gap-4">
              {near(b.id).map((p) => <li>{p.town.name}</li>)}
            </ul>
          </div>
        ))}
      </div>

      {far.length > 0 && (
        <div class="mt-8 p-6 rounded-xl bg-white ring-1 ring-black/10">
          <h3 class="font-display font-extrabold text-lg">A long way from any branch?</h3>
          <p class="mt-2 text-black-2 leading-relaxed">
            If you live in or near {far.map((p) => p.town.name).slice(0, -1).join(', ')}, or {far.at(-1)!.town.name}, every branch is a real drive.
            Chapter-wide meetings are often held on Zoom, some branches offer a Zoom link, and we would love to help you start a branch closer to home.
            Email <a href={`mailto:${site.contactEmail}`} class="font-semibold text-red-dark hover:text-red underline underline-offset-4">{site.contactEmail}</a>.
          </p>
        </div>
      )}
    </div>
  </section>
</Base>
