---
// The flyer library. Text in src/data/printables.json; files built by `npm run printables`.
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Journey from '../../../components/Journey.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import site from '../../../data/site.json';
import { href } from '../../../lib/paths';
import { getDesigns, getPrintables, getReadyMade, previewFile, printablesText } from '../../../lib/printables';
import { getUploads, uploadsFolder } from '../../../lib/uploads';

const designs = await getDesigns();
const ready = getReadyMade();
const flyerSections = [
  { id: 'join', group: 'join', bg: 'bg-mist', eyebrow: 'Join us', title: 'Ready-made recruiting flyers.', lede: 'Nothing to fill in. The QR code goes to the chapter sign-up form. Print sizes are PDFs; social sizes are JPG images.' },
  { id: 'event', group: 'event', bg: 'bg-white', eyebrow: 'Event flyers', title: 'Add your event, then print.', lede: 'Print sizes are PDFs with fill-in boxes for when, where, and a short note. Social sizes are JPG images, ready to post.' },
  { id: 'hangouts', group: 'hangout', bg: 'bg-mist', eyebrow: 'Hangouts and socials', title: 'Coffee, snacks, and good company.', lede: 'Invitations to socials, with fill-in boxes for when and where. The QR code goes to the events calendar. Social sizes are JPG images that point people to the calendar.' },
] as const;
const items = await getPrintables();
const { howTo, rules } = printablesText;
const linkClass = 'font-semibold text-red-dark hover:text-red underline underline-offset-4 decoration-2';
const downloadName = (file: string) => file.split('/').pop();

// Member uploads. The button opens the folder on GitHub, whose README explains uploading.
const uploads = getUploads();
const uploadFolder = `${site.links.github}/tree/main/${uploadsFolder}`;
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Flyers and printables" description="Printable flyers and social media images for Central Sierra Foothills DSA, for tabling, meetings, and events. Fill in your event details before you print.">
  <PageHeader
    eyebrow="For members"
    title="Flyers and printables."
    lede="Flyers you can fill in with your event details, plus ready-to-go signs, handouts, and images for tables, meetings, and social media."
    back={{ href: href('/member-resources/'), label: 'Member resources' }}
  >
    <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-2">
      {[['#shared', 'Shared flyers'], ['#join', 'Join us flyers'], ['#event', 'Event flyers'], ['#hangouts', 'Hangouts and socials'],['#ready', 'Signs, handouts, and images']].map(([to, label]) => (
        <a href={to} class="px-4 py-2 rounded-full bg-white/10 ring-1 ring-white/40 hover:bg-white hover:text-red-dark font-semibold text-sm transition-colors">{label}</a>
      ))}
    </nav>
  </PageHeader>
  <Journey current="active" />

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-6">
      <div class="rounded-xl bg-mist p-6 sm:p-8">
        <h2 class="font-display font-extrabold text-2xl">How to fill one in</h2>
        <ol class="mt-4 space-y-3">
          {howTo.map((step, i) => (
            <li class="flex gap-3 leading-relaxed">
              <span class="w-7 h-7 shrink-0 rounded-full bg-red text-white font-display font-black text-sm flex items-center justify-center" aria-hidden="true">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="rounded-xl ring-1 ring-black/10 p-6 sm:p-8">
        <h2 class="font-display font-extrabold text-2xl">Use them well</h2>
        <ul class="mt-4 space-y-3">
          {rules.map((r) => (
            <li class="flex gap-3 leading-relaxed"><span class="mt-2 w-2 h-2 shrink-0 rounded-full bg-red" aria-hidden="true"></span>{r}</li>
          ))}
        </ul>
        <p class="mt-4 text-black-2">Questions? Email <a href={`mailto:${site.contactEmail}`} class={linkClass}>{site.contactEmail}</a>.</p>
      </div>
    </div>
  </section>

  <!-- Shared flyers: whatever members have uploaded to public/files/printables/uploads/ -->
  <section id="shared" class="py-12 sm:py-16 bg-black text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8">
          <SectionHeading eyebrow="Shared flyers" title="Made by members, for the chapter." tone="dark" lede="Flyers for specific events and campaigns, uploaded by members and reviewed by the steering committee." />
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <a href={uploadFolder} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 bg-red hover:bg-red-dark rounded-md font-semibold transition-colors">
            Add a flyer <span aria-hidden="true">↗</span>
          </a>
          <p class="mt-2 text-sm text-white/60">Needs a GitHub account with access to the site.</p>
        </div>
      </div>

      {uploads.length > 0 ? (
        <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {uploads.map((u) => (
            <li class="bg-white text-black rounded-xl overflow-hidden flex flex-col">
              <div class="aspect-[4/3] bg-mist flex items-center justify-center p-4 border-b border-black/10">
                {u.preview ? (
                  <img src={u.preview} alt={`Preview: ${u.title}`} loading="lazy" class="max-w-full max-h-full w-auto h-auto shadow-md" />
                ) : (
                  <span class="w-20 h-24 rounded-md bg-red text-white font-display font-black text-xl flex items-end justify-center pb-3 shadow-md" aria-hidden="true">PDF</span>
                )}
              </div>
              <div class="p-5 flex-1 flex flex-col">
                {u.date && <p class="text-xs font-semibold tracking-[0.16em] uppercase text-red-dark">{dateFmt.format(u.date)}</p>}
                <h3 class="mt-1 font-display font-extrabold text-lg leading-snug">{u.title}</h3>
                {u.description && <p class="mt-1 text-sm text-black-2 leading-relaxed">{u.description}</p>}
                <p class="mt-auto pt-4">
                  <a href={u.file} download={u.fileName} class={linkClass}>Download {u.kind === 'pdf' ? 'PDF' : 'image'}</a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 rounded-xl ring-1 ring-white/15 p-6 text-white/80 leading-relaxed max-w-3xl">
          Nothing here yet. Made a flyer for an event? Steering committee members can add it with the button above. The folder on GitHub explains how, step by step.
        </p>
      )}
    </div>
  </section>

  {flyerSections.map((s) => (
  <section id={s.id} class:list={['py-12 sm:py-16', s.bg]}>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow={s.eyebrow} title={s.title} lede={s.lede} />
      <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {designs.filter((d) => d.group === s.group).map((d) => {
          const files = items.filter((p) => p.design.id === d.id);
          const print = files.filter((p) => p.format.kind === 'pdf');
          const social = files.filter((p) => p.format.kind === 'png');
          return (
            <li class="bg-white rounded-xl ring-1 ring-black/10 overflow-hidden flex flex-col">
              <img
                src={href(previewFile(d.id))}
                alt={`Preview of the ${d.title} flyer: "${d.headline}"`}
                width="490" height="634" loading="lazy"
                class="w-full h-auto border-b border-black/10"
              />
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-display font-extrabold text-xl">{d.title}</h3>
                <p class="mt-1 text-black-2 text-sm">QR code goes to {d.qrUrl.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</p>

                <h4 class="mt-5 text-xs font-semibold tracking-[0.18em] uppercase text-red-dark">Print (PDF)</h4>
                <ul class="mt-2 space-y-2">
                  {print.map((p) => (
                    <li>
                      <a href={href(p.file)} download={downloadName(p.file)} class={linkClass}>{p.format.label}</a>
                      <span class="block text-sm text-black-2">{p.format.size}</span>
                    </li>
                  ))}
                </ul>

                <h4 class="mt-5 text-xs font-semibold tracking-[0.18em] uppercase text-red-dark">Social media (JPG)</h4>
                <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
                  {social.map((p) => (
                    <li>
                      <a href={href(p.file)} download={downloadName(p.file)} class={linkClass}>{p.format.label}</a>
                      <span class="block text-sm text-black-2">{p.format.size}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
  ))}

  <section id="ready" class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Ready to go" title="Nothing to fill in. Print or post." lede="Signs, handouts, and sheets for tables and meetings, plus images to share." />
      {(['print', 'social'] as const).map((group) => (
        <>
          <h3 class="mt-10 font-display font-extrabold text-2xl">{group === 'print' ? 'To print' : 'To share'}</h3>
          <ul class="mt-5 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {ready.filter((r) => r.group === group).map((r) => (
              <li class="bg-white rounded-xl ring-1 ring-black/10 overflow-hidden flex flex-col">
                <div class="bg-mist aspect-[4/3] flex items-center justify-center p-4 border-b border-black/10">
                  <img
                    src={href(r.preview)}
                    alt={`Preview: ${r.title}`}
                    loading="lazy"
                    class="max-w-full max-h-full w-auto h-auto shadow-md"
                  />
                </div>
                <div class="p-5 flex-1 flex flex-col">
                  <h4 class="font-display font-extrabold text-lg leading-snug">{r.title}</h4>
                  <p class="mt-1 text-black-2 text-sm leading-relaxed flex-1">{r.blurb}</p>
                  <p class="mt-3">
                    <a href={href(r.file)} download={downloadName(r.file)} class={linkClass}>Download {r.kind.toUpperCase()}</a>
                    <span class="block text-sm text-black-2">{r.size}</span>
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </>
      ))}
    </div>
  </section>
</Base>
