---
// The flyer library. Text in src/data/printables.json; files built by `npm run printables`.
// Member uploads come from src/flyers/ (see src/lib/uploads.ts).
//
// The groups are tabs that work without JavaScript: each tab is a radio button,
// and the generated CSS below hides every panel except the checked one.
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Journey from '../../../components/Journey.astro';
import site from '../../../data/site.json';
import { href } from '../../../lib/paths';
import { getDesigns, getPrintables, getReadyMade, previewFile, printablesText, type FormatId } from '../../../lib/printables';
import { getUploads, uploadsFolder } from '../../../lib/uploads';

const designs = await getDesigns();
const items = await getPrintables();
const ready = getReadyMade();
const uploads = getUploads();
const { howTo, rules } = printablesText;

const uploadFolder = `${site.links.github}/tree/main/${uploadsFolder}`;
const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const linkClass = 'font-semibold text-red-dark hover:text-red underline underline-offset-4 decoration-2';
const downloadName = (file: string) => file.split('/').pop();

// Short button labels for each format; the full size shows on hover.
const short: Record<FormatId, string> = {
  poster: 'Poster', half: 'Half page', quarter: 'Quarter',
  square: 'Square', portrait: 'Portrait', story: 'Story',
};

const flyerTabs = [
  { id: 'join', group: 'join', label: 'Join us', lede: 'Ready-made recruiting flyers. Nothing to fill in; the QR code goes to the chapter sign-up form.' },
  { id: 'event', group: 'event', label: 'Event flyers', lede: 'Print versions have fill-in boxes for when, where, and a short note. Social images are ready to post.' },
  { id: 'hangouts', group: 'hangout', label: 'Hangouts', lede: 'Invitations to socials, with fill-in boxes for when and where. The QR code goes to the events calendar.' },
] as const;

const tabs = [
  ...flyerTabs.map((t) => ({ id: t.id, label: t.label, count: designs.filter((d) => d.group === t.group).length })),
  { id: 'ready', label: 'Signs & handouts', count: ready.length },
  { id: 'shared', label: 'Shared by members', count: uploads.length },
];

const tabCss = tabs
  .map((t) => `.flyer-tabs:has(input[value="${t.id}"]:checked) ~ .flyer-panels > [data-panel]:not([data-panel="${t.id}"]) { display: none; }`)
  .join('\n');

const pill = 'inline-block px-2.5 py-1 rounded-md bg-mist hover:bg-red-dark hover:text-white text-sm font-semibold transition-colors';
---
<Base title="Flyers and printables" description="Printable flyers and social media images for Central Sierra Foothills DSA, for tabling, meetings, and events. Fill in your event details before you print.">
  <PageHeader
    eyebrow="For members"
    title="Flyers and printables."
    lede="Flyers you can fill in with your event details, plus ready-to-go signs, handouts, and images for tables, meetings, and social media."
    back={{ href: href('/member-resources/'), label: 'Member resources' }}
  />
  <Journey current="active" />

  <section class="py-10 sm:py-14 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Instructions, folded away -->
      <div class="grid md:grid-cols-2 gap-3">
        <details class="group rounded-xl bg-mist">
          <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer list-none font-display font-extrabold text-lg">
            <span class="w-7 h-7 rounded-full bg-red-dark text-white text-sm flex items-center justify-center" aria-hidden="true">?</span>
            <span class="flex-1">How to fill in and print</span>
            <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" /></svg>
          </summary>
          <ol class="px-5 pb-5 space-y-3">
            {howTo.map((step, i) => (
              <li class="flex gap-3 leading-relaxed">
                <span class="w-6 h-6 shrink-0 rounded-full bg-black text-white font-display font-black text-xs flex items-center justify-center" aria-hidden="true">{i + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </details>
        <details class="group rounded-xl bg-mist">
          <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer list-none font-display font-extrabold text-lg">
            <span class="w-7 h-7 rounded-full bg-red-dark text-white text-sm flex items-center justify-center" aria-hidden="true">!</span>
            <span class="flex-1">Use them well</span>
            <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="px-5 pb-5">
            <ul class="space-y-3">
              {rules.map((r) => (
                <li class="flex gap-3 leading-relaxed"><span class="mt-2 w-2 h-2 shrink-0 rounded-full bg-red" aria-hidden="true"></span>{r}</li>
              ))}
            </ul>
            <p class="mt-4 text-black-2">Questions? Email <a href={`mailto:${site.contactEmail}`} class={linkClass}>{site.contactEmail}</a>.</p>
          </div>
        </details>
      </div>

      <!-- Tabs -->
      <style set:html={tabCss}></style>
      <fieldset class="flyer-tabs mt-10 border-b-2 border-black/10">
        <legend class="sr-only">Show</legend>
        <div class="flex flex-wrap gap-x-1 gap-y-2 -mb-0.5">
          {tabs.map((t, i) => (
            <label class="tab">
              <input type="radio" name="flyer-tab" value={t.id} class="sr-only" checked={i === 0} />
              {t.label} <span class="tab-count">{t.count}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="flyer-panels mt-8">
        {flyerTabs.map((t) => (
          <section id={t.id} data-panel={t.id} aria-label={t.label}>
            <p class="max-w-3xl text-lg text-black-1 leading-relaxed">{t.lede}</p>
            <ul class="tray mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
              {designs.filter((d) => d.group === t.group).map((d) => {
                const files = items.filter((p) => p.design.id === d.id);
                return (
                  <li class="rounded-xl ring-1 ring-black/10 overflow-hidden flex flex-col">
                    <div class="aspect-[4/3] overflow-hidden border-b border-black/10 bg-mist">
                      <img
                        src={href(previewFile(d.id))}
                        alt={`Preview of the ${d.title} flyer: "${d.headline}"`}
                        width="490" height="634" loading="lazy"
                        class="w-full h-full object-cover object-top"
                      />
                    </div>
                    <div class="p-4 flex-1 flex flex-col">
                      <h3 class="font-display font-extrabold text-lg leading-snug">{d.title}</h3>
                      {(['pdf', 'png'] as const).map((kind) => (
                        <div class="mt-3">
                          <p class="text-xs font-semibold tracking-[0.14em] uppercase text-black-2">{kind === 'pdf' ? 'Print (PDF)' : 'Social (JPG)'}</p>
                          <ul class="mt-1.5 flex flex-wrap gap-1.5">
                            {files.filter((p) => p.format.kind === kind).map((p) => (
                              <li><a href={href(p.file)} download={downloadName(p.file)} title={`${p.format.label}, ${p.format.size}`} class={pill}>{short[p.formatId]}</a></li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </li>
                );
              })}
            </ul>
            <p class="mt-6 text-sm text-black-2">
              <strong class="text-black">Sizes:</strong> poster 8.5 × 11 in · half page 5.5 × 8.5 in, 2 per sheet · quarter 4.25 × 5.5 in, 4 per sheet · square 1080 × 1080 · portrait 1080 × 1350 · story 1080 × 1920.
            </p>
          </section>
        ))}

        <section id="ready" data-panel="ready" aria-label="Signs and handouts">
          <p class="max-w-3xl text-lg text-black-1 leading-relaxed">Signs, handouts, and sheets for tables and meetings, plus images to share. Nothing to fill in.</p>
          <ul class="tray mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {ready.map((r) => (
              <li class="rounded-xl ring-1 ring-black/10 overflow-hidden flex flex-col">
                <div class="bg-mist aspect-[4/3] flex items-center justify-center p-4 border-b border-black/10">
                  <img src={href(r.preview)} alt={`Preview: ${r.title}`} loading="lazy" class="max-w-full max-h-full w-auto h-auto shadow-md" />
                </div>
                <div class="p-4 flex-1 flex flex-col">
                  <p class="text-xs font-semibold tracking-[0.14em] uppercase text-red-dark">{r.group === 'print' ? 'To print' : 'To share'}</p>
                  <h3 class="mt-1 font-display font-extrabold text-lg leading-snug">{r.title}</h3>
                  <p class="mt-1 text-black-2 text-sm leading-relaxed flex-1">{r.blurb}</p>
                  <p class="mt-3 flex flex-wrap items-center gap-2">
                    <a href={href(r.file)} download={downloadName(r.file)} class={pill}>Download {r.kind === 'pdf' ? 'PDF' : 'image'}</a>
                    <span class="text-xs text-black-2">{r.size}</span>
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section id="shared" data-panel="shared" aria-label="Shared by members">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <p class="max-w-2xl text-lg text-black-1 leading-relaxed">Flyers for specific events and campaigns, uploaded by members and reviewed by the steering committee.</p>
            <div class="text-right">
              <a href={uploadFolder} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 bg-red-dark hover:bg-black-1 text-white rounded-md font-semibold transition-colors">Add a flyer <span aria-hidden="true">↗</span></a>
              <p class="mt-1.5 text-xs text-black-2">Needs a GitHub account with access to the site.</p>
            </div>
          </div>
          {uploads.length > 0 ? (
            <ul class="tray mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
              {uploads.map((u) => (
                <li class="rounded-xl ring-1 ring-black/10 overflow-hidden flex flex-col">
                  <div class="aspect-[4/3] bg-mist flex items-center justify-center p-4 border-b border-black/10">
                    {u.preview ? (
                      <img src={u.preview} alt={`Preview: ${u.title}`} loading="lazy" class="max-w-full max-h-full w-auto h-auto shadow-md" />
                    ) : (
                      <span class="w-20 h-24 rounded-md bg-red-dark text-white font-display font-black text-xl flex items-end justify-center pb-3 shadow-md" aria-hidden="true">PDF</span>
                    )}
                  </div>
                  <div class="p-4 flex-1 flex flex-col">
                    {u.date && <p class="text-xs font-semibold tracking-[0.14em] uppercase text-red-dark">{dateFmt.format(u.date)}</p>}
                    <h3 class="mt-1 font-display font-extrabold text-lg leading-snug">{u.title}</h3>
                    {u.description && <p class="mt-1 text-sm text-black-2 leading-relaxed">{u.description}</p>}
                    <p class="mt-auto pt-3"><a href={u.file} download={u.fileName} class={pill}>Download {u.kind === 'pdf' ? 'PDF' : 'image'}</a></p>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-6 rounded-xl bg-mist p-6 text-black-1 leading-relaxed max-w-3xl">
              Nothing here yet. Made a flyer for an event? Steering committee members can add it with the button above. The folder on GitHub explains how, step by step.
            </p>
          )}
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  summary::-webkit-details-marker { display: none; }

  .tab {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.7rem 1rem;
    border-bottom: 3px solid transparent;
    font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;
    color: var(--color-black-2);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab:hover { color: var(--color-black); border-bottom-color: var(--color-black-4); }
  .tab:has(input:checked) { color: var(--color-red-dark); border-bottom-color: var(--color-red); }
  .tab:has(input:focus-visible) { outline: 3px solid var(--color-red); outline-offset: 2px; border-radius: 4px; }
  .tab-count {
    font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700;
    padding: 0.05rem 0.45rem; border-radius: 999px;
    background: var(--color-mist); color: var(--color-black-2);
  }
  .tab:has(input:checked) .tab-count { background: var(--color-red-dark); color: white; }
</style>
