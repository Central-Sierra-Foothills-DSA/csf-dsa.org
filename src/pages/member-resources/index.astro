---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import site from '../../data/site.json';
import groups from '../../data/working-groups.json';
import { href } from '../../lib/paths';
import { guide, resolveLink, packetPath } from '../../lib/member-guide';

// Page text lives in src/data/member-guide.json, shared with the printable packet.
const packet = href(packetPath);
const { membership, structure, participation, tools, standards, workbook, nextSteps } = guide;
const linkClass = 'font-semibold text-red-dark hover:text-red underline underline-offset-4 decoration-2';
---
<Base title="Member resources" description="A guide for new members of Central Sierra Foothills DSA: how the chapter works, how to stay connected, our community standards, and a printable new member packet.">
  <PageHeader eyebrow="For members" title="Welcome to the chapter." lede="You joined. Here's how the chapter works, where the conversation happens, and how to find your place in the work. Whether you're new to organizing or not, you belong here." />

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Start here" title="One chapter, a lot of ground." />
        <div class="mt-6 space-y-5 text-lg leading-relaxed">
          <p>
            Our chapter covers {site.counties.slice(0, -1).join(', ')}, and {site.counties.at(-1)} counties, from Roseville and El Dorado Hills up to Truckee and Tahoe. {guide.region}
          </p>
          <p>Our goal is simple: {guide.goal.charAt(0).toLowerCase() + guide.goal.slice(1)}</p>
        </div>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          <a href={href('/learn/')} class={linkClass}>What is democratic socialism? →</a>
          <a href={href('/about/')} class={linkClass}>About the chapter →</a>
        </div>
      </div>
      <aside class="lg:col-span-5 rounded-xl bg-black text-white p-6 sm:p-8">
        <p class="font-semibold tracking-[0.18em] uppercase text-xs text-red-2">Printable</p>
        <h2 class="mt-2 font-display font-extrabold text-2xl leading-tight">New member packet</h2>
        <p class="mt-3 text-white/75 leading-relaxed">Everything on this page, plus an optional workbook with reflection questions to fill in at your own pace.</p>
        <a href={packet} download class="mt-5 inline-flex items-center gap-2 px-5 py-3 bg-red hover:bg-red-dark rounded-md font-semibold transition-colors">
          Download the packet <span class="text-white/70 font-normal">(PDF)</span>
        </a>
      </aside>
    </div>
  </section>

  <section id="membership" class="py-12 sm:py-16 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Membership" title="What it takes to be a voting member." />
      <ol class="mt-10 grid md:grid-cols-3 gap-5">
        {membership.map((m, i) => (
          <li class="bg-white rounded-xl p-6 sm:p-7 ring-1 ring-black/10">
            <span class="w-11 h-11 rounded-full bg-red text-white font-display font-black text-lg flex items-center justify-center" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-4 font-display font-extrabold text-xl leading-tight">{m.title}</h3>
            <p class="mt-2 text-black-2 leading-relaxed">{m.body}</p>
            {i === 0 && (
              <a href={site.links.joinDsaNational} target="_blank" rel="noopener" class:list={['mt-3 inline-flex', linkClass]}>Join or renew ↗</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="how-it-works" class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-14">
      <div>
        <SectionHeading eyebrow="How the chapter works" title="Branches, working groups, and you." />
        <div class="mt-6 space-y-4 text-lg leading-relaxed">
          <p>{structure.branches}</p>
          <p>{structure.workingGroups}</p>
          <p>{structure.encourage}</p>
        </div>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          <a href={href('/branches/')} class={linkClass}>Find your branch →</a>
          <a href={href('/about/#decisions')} class={linkClass}>How we make decisions →</a>
        </div>
      </div>
      <div>
        <h3 class="font-display font-extrabold text-2xl">Our working groups</h3>
        <dl class="mt-6 space-y-5">
          {groups.map((g) => (
            <div class="pl-5 border-l-4 border-red">
              <dt class="font-display font-extrabold text-lg">{g.name}</dt>
              <dd class="text-black-2 leading-relaxed">{g.description}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 text-black-2">To join one, ask in Slack or at your next branch meeting.</p>
      </div>
    </div>
  </section>

  <section id="participation" class="py-12 sm:py-16 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-14">
      <div>
        <SectionHeading eyebrow="Taking part" title="Consistency over perfection." />
        <div class="mt-6 space-y-4 text-lg leading-relaxed">
          {participation.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="bg-white rounded-xl p-6 sm:p-8 ring-1 ring-black/10">
        <h3 class="font-display font-extrabold text-xl">When we can, we all try to:</h3>
        <ul class="mt-4 space-y-3">
          {participation.hopes.map((h) => (
            <li class="flex gap-3 leading-relaxed"><span class="mt-2 w-2 h-2 shrink-0 rounded-full bg-red" aria-hidden="true"></span>{h}</li>
          ))}
        </ul>
        <h3 class="mt-8 font-display font-extrabold text-xl">What you can expect from us</h3>
        <p class="mt-3 text-black-2 leading-relaxed">{participation.fromUs}</p>
      </div>
    </div>
  </section>

  <section id="stay-connected" class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Stay connected" title="Where the conversation happens." lede="Tip: turn on notifications. Organizing moves quickly." />
      <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {tools.map((t) => {
          const link = resolveLink(t);
          return (
            <li class="rounded-xl p-6 ring-1 ring-black/10 flex flex-col">
              <h3 class="font-display font-extrabold text-xl">{t.name}</h3>
              <p class="mt-2 text-black-2 leading-relaxed flex-1">{t.body}</p>
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined} class:list={['mt-4', linkClass]}>
                {t.label} {link.external ? '↗' : '→'}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section id="standards" class="py-12 sm:py-16 bg-black text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Community standards" title="Solidarity starts with how we treat each other." tone="dark" lede={standards.intro} />
      <div class="mt-10 grid lg:grid-cols-2 gap-6">
        <div class="rounded-xl bg-white/5 ring-1 ring-white/10 p-6 sm:p-8">
          <h3 class="font-display font-extrabold text-xl">Respectful communication</h3>
          <ul class="mt-4 space-y-3 text-white/80">
            {standards.communication.map((c) => (
              <li class="flex gap-3 leading-relaxed"><span class="mt-2 w-2 h-2 shrink-0 rounded-full bg-red" aria-hidden="true"></span>{c}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl bg-white/5 ring-1 ring-white/10 p-6 sm:p-8">
          <h3 class="font-display font-extrabold text-xl">No harassment, anywhere</h3>
          {standards.harassment.map((p, i) => <p class:list={['text-white/80 leading-relaxed', i === 0 ? 'mt-4' : 'mt-3']}>{p}</p>)}
          <p class="mt-4">
            <a href={standards.harassmentPolicyUrl} target="_blank" rel="noopener" class="font-semibold text-red-2 hover:text-white underline underline-offset-4">DSA's national harassment policy ↗</a>
          </p>
        </div>
      </div>

      <h3 class="mt-12 font-display font-extrabold text-2xl">If something goes wrong</h3>
      <p class="mt-3 text-white/80 text-lg leading-relaxed max-w-3xl">{standards.conflict}</p>
      <ol class="mt-6 grid md:grid-cols-3 gap-5">
        {standards.steps.map((s, i) => (
          <li class="rounded-xl bg-white/5 ring-1 ring-white/10 p-6">
            <span class="font-display font-black text-red-2 text-lg">Step {i + 1}</span>
            <h4 class="mt-1 font-display font-extrabold text-lg">{s.title}</h4>
            <p class="mt-2 text-white/80 leading-relaxed">
              {s.body}
              {i === 1 && <> <a href={`mailto:${site.contactEmail}`} class="font-semibold text-red-2 hover:text-white underline underline-offset-4">{site.contactEmail}</a>.</>}
            </p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-white/80">
        Serious concerns are handled under <a href={href('/about/bylaws/')} class="font-semibold text-red-2 hover:text-white underline underline-offset-4">our bylaws</a> and DSA's national policy.
      </p>
    </div>
  </section>

  <section id="workbook" class="py-12 sm:py-16 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Going deeper" title="An optional workbook." lede={workbook.intro} />
      <ol class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {workbook.sections.map((w, i) => (
          <li class="bg-white rounded-xl p-5 ring-1 ring-black/10">
            <span class="text-xs font-semibold tracking-[0.18em] uppercase text-red-dark">Section {i + 1}</span>
            <h3 class="mt-1 font-display font-extrabold text-lg leading-snug">{w.title}</h3>
            <p class="mt-2 text-black-2 text-sm leading-relaxed italic">“{w.sample}”</p>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-lg leading-relaxed max-w-3xl">{workbook.share}</p>
      <p class="mt-4"><a href={packet} download class={linkClass}>Download the packet (PDF) ↓</a></p>
    </div>
  </section>

  <section id="printables" class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8">
        <SectionHeading eyebrow="Tabling and events" title="Flyers and printables." lede="Chapter and branch flyers in poster, half-page, and quarter-page sizes, plus images for social media. Fill in your event details before you print." />
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <a href={href('/member-resources/printables/')} class="inline-flex items-center gap-2 px-5 py-3 bg-red hover:bg-red-dark text-white rounded-md font-semibold transition-colors">
          Browse the flyers →
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-red text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-black text-3xl sm:text-4xl">Your first few steps.</h2>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {nextSteps.map((s) => (
          <li class="px-4 py-2 rounded-full bg-white/10 ring-1 ring-white/30 font-semibold">{s}</li>
        ))}
      </ul>
      <p class="mt-8 text-lg">Questions? Email <a href={`mailto:${site.contactEmail}`} class="font-bold underline underline-offset-4">{site.contactEmail}</a>. A real person will write back.</p>
    </div>
  </section>
</Base>
