---
// The printable new member packet. Run `npm run packet` (with `npm run dev` going)
// to save it as public/files/csf-dsa-new-member-packet.pdf.
// Text lives in src/data/member-guide.json, shared with /member-resources/.
import { Image } from 'astro:assets';
import Print from '../../layouts/Print.astro';
import QR from '../../components/QR.astro';
import site from '../../data/site.json';
import groups from '../../data/working-groups.json';
import { guide, resolveLink, displayUrl } from '../../lib/member-guide';
import bridge from '../../assets/photos/foresthill-bridge.jpg';
import map from '../../assets/photos/chapter-map.jpg';
import badgeWhite from '../../assets/logos/csf-dsa-white.png';
import national from '../../assets/logos/dsa-national-circle.png';

const { democraticSocialism: ds, membership, structure, participation, tools, standards, workbook, nextSteps } = guide;
const siteUrl = 'https://csf-dsa.org';
const resourcesUrl = `${siteUrl}/member-resources/`;
// A printable URL that line-breaks only after slashes and hyphens.
const wrapUrl = (url: string) =>
  displayUrl(url).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!).replace(/([/-])/g, '$1<wbr>');
const counties =`${site.counties.slice(0, -1).join(', ')}, and ${site.counties.at(-1)} counties`;
---
<Print title="New member packet">
  <!-- Cover -->
  <section class="bleed bg-black text-white">
    <Image loading="eager" src={bridge} alt="" format="jpg" quality={70} widths={[1275]} sizes="8.5in" class="absolute inset-0 w-full h-full object-cover opacity-55" />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/20"></div>
    <div class="relative h-full flex flex-col justify-between p-[0.75in]">
      <div class="flex items-center gap-4">
        <Image loading="eager" src={badgeWhite} alt="" width={240} height={240} class="w-[1.1in] h-[1.1in]" />
        <p class="font-display font-bold text-[13pt] leading-tight">Central Sierra<br />Foothills DSA</p>
      </div>
      <div>
        <p class="eyebrow text-red-2"><span class="rule"></span>New member packet</p>
        <h1 class="mt-3 font-display font-black text-[52pt] leading-[0.95]">Welcome to<br />the chapter.</h1>
        <p class="mt-6 text-[15pt] leading-snug text-white/85 max-w-[5.2in]">How the chapter works, how to stay connected, and an optional workbook to help you find your place in the work.</p>
        <div class="mt-10 h-[6px] w-[1.4in] bg-red"></div>
        <p class="mt-4 font-semibold text-[11pt] text-white/70">csf-dsa.org · {counties}, California</p>
      </div>
    </div>
  </section>

  <div class="flow">
    <!-- Start here -->
    <section>
      <p class="eyebrow text-red-dark"><span class="rule"></span>Part 1 · Start here</p>
      <h2 class="h2">One chapter, a lot of ground.</h2>
      <div class="mt-4 space-y-3 text-[11.5pt]">
        {guide.welcome.map((p) => <p>{p}</p>)}
        <p>We serve {counties}, including:</p>
      </div>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {guide.towns.map((t) => <li class="px-2.5 py-0.5 rounded-full bg-mist font-semibold text-[9.5pt]">{t}</li>)}
      </ul>
      <Image loading="eager" src={map} alt="Map of the chapter's area across Placer, Nevada, El Dorado, and Sierra counties" format="jpg" quality={75} widths={[1200]} sizes="6.4in" class="mt-4 mx-auto h-[3.9in] w-auto rounded-lg ring-1 ring-black/10" />
      <p class="mt-4 text-[11pt]">{guide.region}</p>
      <div class="keep mt-5 rounded-lg bg-red text-white p-5">
        <p class="eyebrow text-white/80">Our goal is simple</p>
        <p class="mt-1 font-display font-extrabold text-[16pt] leading-snug">{guide.goal}</p>
      </div>
    </section>

    <!-- Democratic socialism -->
    <section class="new-page">
      <p class="eyebrow text-red-dark"><span class="rule"></span>The basics</p>
      <h2 class="h2">What is democratic socialism?</h2>
      <p class="mt-4 text-[11.5pt]">{ds.intro}</p>
      <ul class="mt-4 space-y-2.5">
        {ds.points.map((p) => (
          <li class="flex gap-3 text-[11.5pt]"><span class="dot"></span><span>{p}</span></li>
        ))}
      </ul>
      <p class="mt-4 text-[11.5pt]">{ds.outro}</p>

      <h3 class="h3 mt-8">Read more</h3>
      <p class="text-black-2">Scan a code with your phone camera, or type the address.</p>
      <ul class="mt-4 grid grid-cols-2 gap-3">
        {guide.readMore.map((r) => (
          <li class="keep flex items-center gap-3 rounded-lg ring-1 ring-black/10 p-3">
            <QR url={r.url} class="w-[0.8in] h-[0.8in]" />
            <div>
              <p class="font-display font-bold leading-tight">{r.label}</p>
              <p class="mt-1 text-[8.5pt] text-black-2" set:html={wrapUrl(r.url)} />
            </div>
          </li>
        ))}
      </ul>

    </section>

    <!-- Membership + how the chapter works -->
    <section class="new-page">
      <p class="eyebrow text-red-dark"><span class="rule"></span>Membership</p>
      <h2 class="h2">What it takes to be a voting member.</h2>
      <ol class="mt-4 grid grid-cols-3 gap-3">
        {membership.map((m, i) => (
          <li class="keep rounded-lg ring-1 ring-black/15 p-3.5">
            <span class="num">{i + 1}</span>
            <h3 class="mt-2 font-display font-extrabold text-[11.5pt] leading-tight">{m.title}</h3>
            <p class="mt-1 text-[9pt] leading-snug text-black-1">{m.body}</p>
          </li>
        ))}
      </ol>
      <div class="keep mt-3 flex items-center gap-4 rounded-lg bg-mist p-3">
        <QR url={site.links.joinDsaNational} class="w-[0.7in] h-[0.7in]" />
        <p class="text-[10pt]"><span class="font-display font-extrabold">Join or renew your membership</span><br /><span class="font-semibold text-red-dark" set:html={wrapUrl(site.links.joinDsaNational)} /></p>
      </div>

      <p class="eyebrow text-red-dark mt-6"><span class="rule"></span>How the chapter works</p>
      <h2 class="h2">Branches, working groups, and you.</h2>
      <div class="mt-4 grid grid-cols-3 gap-3">
        {[
          { t: 'Branches', b: structure.branches },
          { t: 'Working groups', b: structure.workingGroups },
          { t: 'Steering committee', b: structure.steering },
        ].map((c) => (
          <div class="keep rounded-lg bg-mist p-3.5">
            <h3 class="font-display font-extrabold text-[12pt]">{c.t}</h3>
            <p class="mt-1 text-[9pt] leading-snug text-black-1">{c.b}</p>
          </div>
        ))}
      </div>
      <p class="mt-3 text-[10.5pt]">{structure.encourage} To join one, ask in Slack or at your next branch meeting.</p>
      <h3 class="h3 mt-4">Our working groups</h3>
      <dl class="mt-2 grid grid-cols-3 gap-x-5 gap-y-2.5">
        {groups.map((g) => (
          <div class="keep pl-3 border-l-[3px] border-red">
            <dt class="font-display font-extrabold text-[10pt] leading-tight">{g.name}</dt>
            <dd class="mt-0.5 text-[8.5pt] leading-snug text-black-2">{g.description}</dd>
          </div>
        ))}
      </dl>

    </section>

    <!-- Taking part + stay connected -->
    <section class="new-page">
      <p class="eyebrow text-red-dark"><span class="rule"></span>Taking part</p>
      <h2 class="h2">Consistency over perfection.</h2>
      <div class="mt-4 grid grid-cols-2 gap-6">
        <div class="space-y-3 text-[10.5pt]">
          {participation.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="keep rounded-lg ring-1 ring-black/15 p-4">
          <h3 class="font-display font-extrabold text-[11.5pt]">When we can, we all try to:</h3>
          <ul class="mt-2 space-y-1.5 text-[9.5pt]">
            {participation.hopes.map((h) => <li class="flex gap-2"><span class="dot"></span><span>{h}</span></li>)}
          </ul>
          <h3 class="mt-3 font-display font-extrabold text-[11.5pt]">What you can expect from us</h3>
          <p class="mt-1 text-[9.5pt] text-black-1">{participation.fromUs}</p>
        </div>
      </div>

      <p class="eyebrow text-red-dark mt-8"><span class="rule"></span>Stay connected</p>
      <h2 class="h2">Where the conversation happens.</h2>
      <p class="mt-1 text-[10.5pt] text-black-2">Tip: turn on notifications. Organizing moves quickly.</p>
      <ul class="mt-3 grid grid-cols-2 gap-3">
        {tools.map((t) => {
          const link = resolveLink(t);
          return (
            <li class="keep flex items-start gap-3 rounded-lg ring-1 ring-black/15 p-3">
              <QR url={link.absolute} class="w-[0.7in] h-[0.7in]" />
              <div>
                <h3 class="font-display font-extrabold text-[11.5pt] leading-tight">{t.name}</h3>
                <p class="mt-0.5 text-[8.5pt] leading-snug text-black-1">{t.body}</p>
                <p class="mt-0.5 font-semibold text-[8.5pt] text-red-dark" set:html={wrapUrl(link.absolute)} />
              </div>
            </li>
          );
        })}
        <li class="keep rounded-lg bg-mist p-3 flex flex-col justify-center">
          <h3 class="font-display font-extrabold text-[11.5pt] leading-tight">Questions about any of this?</h3>
          <p class="mt-0.5 text-[9pt] text-black-1">Email <span class="font-semibold text-red-dark">{site.contactEmail}</span>. A real person will write back.</p>
        </li>
      </ul>
    </section>

    <!-- Community standards -->
    <section class="new-page">
      <p class="eyebrow text-red-dark"><span class="rule"></span>Community standards</p>
      <h2 class="h2">Solidarity starts with how we treat each other.</h2>
      <p class="mt-4 text-[11pt]">{standards.intro}</p>
      <div class="mt-5 grid grid-cols-2 gap-4">
        <div class="keep rounded-lg bg-mist p-4">
          <h3 class="font-display font-extrabold text-[12.5pt]">Respectful communication</h3>
          <ul class="mt-2 space-y-1.5 text-[9.5pt]">
            {standards.communication.map((c) => <li class="flex gap-2"><span class="dot"></span><span>{c}</span></li>)}
          </ul>
        </div>
        <div class="keep rounded-lg bg-mist p-4">
          <h3 class="font-display font-extrabold text-[12.5pt]">No harassment, anywhere</h3>
          {standards.harassment.map((p) => <p class="mt-2 text-[9.5pt] text-black-1">{p}</p>)}
        </div>
      </div>
      <h3 class="h3 mt-7">If something goes wrong</h3>
      <p class="mt-1 text-[11pt]">{standards.conflict}</p>
      <ol class="mt-4 grid grid-cols-3 gap-3">
        {standards.steps.map((s, i) => (
          <li class="keep rounded-lg ring-1 ring-black/15 p-4">
            <p class="font-display font-black text-red-dark">Step {i + 1}</p>
            <h4 class="font-display font-extrabold text-[12pt] leading-tight">{s.title}</h4>
            <p class="mt-1.5 text-[9.5pt] text-black-1">{s.body}{i === 1 && <> <span class="font-semibold">{site.contactEmail}</span>.</>}</p>
          </li>
        ))}
      </ol>
      <div class="keep mt-5 flex items-center gap-4 text-[9.5pt] text-black-2">
        <QR url={standards.harassmentPolicyUrl} class="w-[0.7in] h-[0.7in]" />
        <p>Serious concerns are handled under the chapter bylaws (csf-dsa.org/about/bylaws) and DSA's national harassment policy. Scan the code to read the national policy.</p>
      </div>
      <p class="mt-6 font-display font-extrabold text-[15pt] text-red-dark">{standards.closing}</p>
    </section>
  </div>

  <!-- Part 2 divider -->
  <section class="bleed bg-red text-white">
    <div class="h-full flex flex-col justify-between p-[0.75in]">
      <p class="eyebrow text-white/80"><span class="rule" style="background: white"></span>Part 2</p>
      <div>
        <h2 class="font-display font-black text-[50pt] leading-[0.95]">Going<br />deeper.</h2>
        <p class="mt-4 font-display font-bold text-[18pt]">A political education workbook</p>
        <p class="mt-6 text-[13pt] leading-relaxed max-w-[5.6in] text-white/90">{workbook.intro}</p>
      </div>
      <ol class="grid grid-cols-2 gap-x-8 gap-y-2 text-[11pt] max-w-[6in]">
        {workbook.sections.map((s, i) => (
          <li class="flex gap-3 border-t border-white/30 pt-2"><span class="font-black">{String(i + 1).padStart(2, '0')}</span><span class="font-semibold">{s.title}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="flow">
    {workbook.sections.map((s, si) => (
      <section class:list={[si > 0 && 'new-page']}>
        <p class="eyebrow text-red-dark"><span class="rule"></span>Section {si + 1} of {workbook.sections.length}</p>
        <h2 class="h2">{s.title}</h2>
        {s.intro && <p class="mt-2 text-[11pt] text-black-2">{s.intro}</p>}
        {s.reading && (
          <div class="keep mt-4 rounded-lg bg-mist p-3">
            <p class="eyebrow text-black-2 mb-2">Optional reading</p>
            <ul class="flex flex-wrap gap-x-5 gap-y-3">
              {s.reading.map((r) => (
                <li class="flex items-center gap-2 w-[2.1in]">
                  <QR url={r.url} class="w-[0.55in] h-[0.55in]" />
                  <div>
                    <p class="font-display font-bold text-[9.5pt] leading-tight">{r.label}</p>
                    <p class="text-[7pt] text-black-2" set:html={wrapUrl(r.url)} />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
        <ol class="mt-4 space-y-4">
          {s.questions.map((q, qi) => (
            <li class="keep">
              <div class="flex gap-3">
                <span class="font-display font-black text-red-dark text-[12pt] leading-tight">{qi + 1}.</span>
                <div class="flex-1">
                  <p class="font-display font-bold text-[12pt] leading-snug">{q.q}</p>
                  {q.examples && <p class="mt-0.5 text-[9.5pt] italic text-black-2">For example: {q.examples}</p>}
                  {q.options && (
                    <ul class="mt-2 grid grid-cols-3 gap-x-4 gap-y-1.5 text-[10pt]">
                      {q.options.map((o) => <li class="flex items-center gap-2"><span class="checkbox"></span>{o}</li>)}
                    </ul>
                  )}
                  {q.lines > 0 && <div class="write-lines mt-1" style={`height: ${q.lines * 0.36}in`}></div>}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <!-- Reflection -->
    <section class="new-page">
      <p class="eyebrow text-red-dark"><span class="rule"></span>Time for reflection</p>
      <h2 class="h2">Bring it to the table.</h2>
      <p class="mt-2 text-[11pt] text-black-2">{workbook.reflection.intro}</p>
      <div class="mt-5 space-y-5">
        {workbook.reflection.prompts.map((p) => (
          <div class="keep">
            <h3 class="font-display font-extrabold text-[13pt] text-red-dark">{p.title}</h3>
            <p class="text-[10pt] text-black-2">{p.q}</p>
            <div class="write-lines mt-1" style="height: 1.08in"></div>
          </div>
        ))}
      </div>
    </section>

    <section class="new-page">
      <p class="eyebrow text-red-dark"><span class="rule"></span>You made it</p>
      <h2 class="h2">Your first few steps.</h2>
      <p class="mt-2 text-[11pt] text-black-2">Check them off as you go.</p>
      <ul class="mt-5 space-y-3">
        {nextSteps.map((s) => (
          <li class="flex items-center gap-3 text-[13pt] font-display font-bold"><span class="checkbox w-[0.22in] h-[0.22in]"></span>{s}</li>
        ))}
      </ul>
      <div class="keep mt-8 rounded-lg bg-mist p-5">
        <h3 class="font-display font-extrabold text-[13pt]">Share what you wrote (if you want)</h3>
        <p class="mt-1.5 text-[10.5pt] text-black-1">{workbook.share}</p>
      </div>
      <div class="keep mt-8 flex items-center gap-5 rounded-lg ring-1 ring-black/15 p-5">
        <QR url={resourcesUrl} class="w-[1in] h-[1in]" />
        <div>
          <h3 class="font-display font-extrabold text-[13pt]">Find all of this online</h3>
          <p class="mt-1 text-[10.5pt] text-black-1">The member resources page has every link in this packet, plus the events calendar and branch pages.</p>
          <p class="mt-1 font-semibold text-red-dark">{displayUrl(resourcesUrl)}</p>
        </div>
      </div>
    </section>
  </div>

  <!-- Back cover -->
  <section class="bleed bg-black text-white">
    <div class="h-full flex flex-col items-center justify-center text-center p-[0.75in]">
      <Image loading="eager" src={badgeWhite} alt="" width={320} height={320} class="w-[1.8in] h-[1.8in]" />
      <p class="mt-8 font-display font-black text-[30pt] leading-tight">Welcome to organizing in<br />the Central Sierra Foothills.</p>
      <p class="mt-4 text-[14pt] text-white/75">Learning together is how movements grow.</p>
      <div class="mt-10 h-[5px] w-[1in] bg-red"></div>
      <p class="mt-8 font-semibold text-[12pt]">csf-dsa.org</p>
      <p class="mt-1 text-[12pt] text-white/75">{site.contactEmail}</p>
      <p class="mt-1 text-[11pt] text-white/60">Instagram @csf_dsa · facebook.com/csfdsa</p>
      <Image loading="eager" src={national} alt="Democratic Socialists of America" width={160} height={160} class="mt-12 w-[0.75in] h-[0.75in]" />
    </div>
  </section>
</Print>

<style is:global>
  .eyebrow {
    display: flex; align-items: center; gap: 0.5rem;
    font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; font-size: 8.5pt;
  }
  .eyebrow .rule { display: inline-block; width: 0.3in; height: 2px; background: var(--color-red); }
  .h2 { margin-top: 0.4rem; font-family: var(--font-display); font-weight: 800; font-size: 25pt; line-height: 1.05; }
  .h3 { font-family: var(--font-display); font-weight: 800; font-size: 15pt; line-height: 1.15; }
  .dot { margin-top: 0.5em; width: 7px; height: 7px; border-radius: 9999px; background: var(--color-red); flex-shrink: 0; }
  .num {
    width: 0.38in; height: 0.38in; border-radius: 9999px; flex-shrink: 0;
    background: var(--color-red); color: white; font-family: var(--font-display); font-weight: 900; font-size: 13pt;
    display: flex; align-items: center; justify-content: center;
  }
</style>
