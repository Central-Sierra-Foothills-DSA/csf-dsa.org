---
import EventSchema from '../components/EventSchema.astro';
import ShareLinks from '../components/ShareLinks.astro';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EventsBrowser from '../components/EventsBrowser.astro';
import CalendarSubscribe from '../components/CalendarSubscribe.astro';
import CommunityEvents from '../components/CommunityEvents.astro';
import SuggestEvent from '../components/SuggestEvent.astro';
import UiIcon from '../components/UiIcon.astro';
import site from '../data/site.json';
import { upcomingEvents, eventsFetchedAt, formatShortDate } from '../lib/events';
import { printMonths } from '../lib/calendar';
import { href } from '../lib/paths';

const now = new Date();
const upcoming = upcomingEvents(now);
const linkClass = 'font-semibold text-red-dark hover:text-red underline underline-offset-4';
---
<Base title="Events" description="Upcoming meetings, socials, actions, and trainings from Central Sierra Foothills DSA, with a month view and add-to-calendar links.">
  <PageHeader eyebrow="Events" title="What's coming up." lede="Branch meetings, socials, actions, and local government meetings where our campaigns are on the agenda. You don't have to be a member to show up." />

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <EventsBrowser events={upcoming} now={now} empty="Nothing on the calendar right now. Check back soon." />

      <div class="mt-10"><CommunityEvents now={now} /></div>

      <div class="mt-10"><CalendarSubscribe /></div>

      <div class="mt-4 grid md:grid-cols-2 gap-4">
        <SuggestEvent />
        <div class="rounded-xl ring-1 ring-black/10 p-6">
          <h2 class="flex items-center gap-2 font-display font-bold text-lg"><UiIcon name="document" class="w-5 h-5 text-red-dark shrink-0" /> Print the month</h2>
          <p class="text-sm text-black-2 mt-1 leading-relaxed">A one-page calendar with a QR code, for tables, meetings, and bulletin boards. It updates every morning.</p>
          <p class="mt-3 flex flex-wrap gap-2">
            {printMonths(now).map((m) => (
              <a href={href(`/events/print/${m.key}/`)} class="inline-flex items-center px-4 py-2.5 rounded-md bg-white ring-1 ring-black/15 hover:ring-red-dark hover:text-red-dark font-semibold text-sm transition-colors">{m.label}</a>
            ))}
          </p>
        </div>
      </div>

      <div class="mt-4 p-6 rounded-xl bg-mist flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="font-display font-bold text-lg">RSVP and full details</h2>
          <p class="text-sm text-black-2 mt-1">Each event links to its page on our Solidarity Tech calendar, where you can RSVP and get Zoom links.</p>
        </div>
        <a href={site.links.fullCalendar} target="_blank" rel="noopener" class="shrink-0 inline-flex items-center justify-center px-5 py-3 bg-black hover:bg-black-1 text-white font-semibold rounded-md transition-colors">Open the full calendar ↗</a>
      </div>

      <p class="mt-6 text-sm text-black-2">
        Times are Pacific. This list updates from the calendar automatically (last synced {formatShortDate(eventsFetchedAt)}).
        Looking for something that already happened? <a href={href('/archive/')} class={linkClass}>Browse the archive</a>.
      </p>
    </div>
  </section>
  <ShareLinks title="Upcoming events" />
  <EventSchema events={upcoming} />
</Base>
