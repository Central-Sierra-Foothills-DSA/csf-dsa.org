---
import ShareLinks from '../components/ShareLinks.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Journey from '../components/Journey.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventList from '../components/EventList.astro';
import site from '../data/site.json';
import tabling from '../assets/photos/tabling.jpg';
import { upcomingEvents, typeOf } from '../lib/events';
import { href } from '../lib/paths';
import gettingStarted from '../data/getting-started.json';
import { resolveLink } from '../lib/member-guide';

// Good first events: branch meetings and socials.
const firstEvents = upcomingEvents().filter((e) => ['meeting', 'social'].includes(typeOf(e))).slice(0, 3);

// Steps live in src/data/getting-started.json, shared with the home page.
const steps = gettingStarted.steps.map((s) => {
  const link = resolveLink(s.cta);
  return { title: s.title, body: s.body, cta: { label: s.cta.label, href: link.href, external: link.external } };
});

const faqs = [
  { q: 'Do I have to be a member to come to a meeting?', a: 'No. Branch meetings and most events are open to everyone. Only members vote, but guests are welcome to listen and speak.' },
  { q: 'Do I need to know a lot about socialism?', a: 'Not at all. Most of us joined because something felt unfair and we wanted to do something about it. Our Learn page covers the basics, and nobody will quiz you.' },
  { q: 'Is DSA a political party?', a: 'No. DSA is a member-run organization, not a party. We endorse candidates who share our goals, and we also organize outside of elections: campaigns, mutual aid, labor solidarity, and political education.' },
  { q: 'How much time does it take?', a: 'As much or as little as you have. Some members come to one meeting a month. Others help run campaigns. Both matter.' },
  { q: 'I live a long way from any branch. Can I still take part?', a: 'Yes. Chapter-wide meetings are often held on Zoom, some branches can set up a Zoom link, and working groups meet across county lines. We can also help you start a branch closer to home.' },
  { q: 'What happens at a branch meeting?', a: 'There is usually time to socialize first, often with snacks. Then the agenda: updates from working groups, branch business, and planning for upcoming actions and events.' },
  { q: 'Who decides what the chapter does?', a: 'Members do. Anyone can bring a proposal, we discuss it together, and every member gets a vote by online ballot.' },
];
---
<Base title="New here? Start here" description="New to Central Sierra Foothills DSA? What DSA is, what a first meeting is like, and how to join.">
  <PageHeader eyebrow="Welcome" title="New here? Start here." lede="You don't need to be an expert, or even a member, to get involved. Here's what to expect and how to take the first step." />
  <Journey current="curious" />

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="The basics" title="Who we are, in a minute." />
        <div class="mt-6 space-y-5 text-lg leading-relaxed">
          <p>
            The Democratic Socialists of America is the largest socialist organization in the country. We're a member-run organization of working people who believe the economy and the government should serve everyone, not just the wealthy few.
          </p>
          <p>
            Central Sierra Foothills DSA is the chapter for {site.counties.slice(0, -1).join(', ')}, and {site.counties.at(-1)} counties. We have about {site.approxMembers} members and four local branches. We run campaigns, show up at city councils, table at community events, and look out for each other.
          </p>
        </div>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-semibold">
          <a href={href('/about/')} class="text-red-dark hover:text-red underline underline-offset-4 decoration-2">More about the chapter →</a>
          <a href={href('/learn/')} class="text-red-dark hover:text-red underline underline-offset-4 decoration-2">What is democratic socialism? →</a>
        </div>
      </div>
      <Image src={tabling} alt="A chapter member talking with passersby at an outdoor tabling event" widths={[400, 720]} sizes="(min-width: 1024px) 440px, 100vw" class="lg:col-span-5 w-full h-64 sm:h-80 object-cover rounded-xl shadow-md ring-1 ring-black/10" />
    </div>
  </section>

  <section id="steps" class="py-12 sm:py-16 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Getting started" title="Four steps, at your own pace." />
      <ol class="mt-10 grid md:grid-cols-2 gap-5">
        {steps.map((s, i) => (
          <li class="bg-white rounded-xl p-6 sm:p-7 ring-1 ring-black/10 flex gap-5">
            <span class="shrink-0 w-11 h-11 rounded-full bg-red-dark text-white font-display font-black text-lg flex items-center justify-center" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="font-display font-extrabold text-xl leading-tight">{s.title}</h3>
              <p class="mt-2 text-black-2 leading-relaxed">{s.body}</p>
              <a href={s.cta.href} target={s.cta.external ? '_blank' : undefined} rel={s.cta.external ? 'noopener' : undefined} class="mt-3 inline-flex items-center gap-1.5 font-semibold text-red-dark hover:text-red underline underline-offset-4 decoration-2">
                {s.cta.label} {s.cta.external ? '↗' : '→'}
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-14">
      <div>
        <SectionHeading eyebrow="Good first events" title="Pick one and show up." />
        <div class="mt-8">
          <EventList events={firstEvents} compact empty="No meetings or socials on the calendar right now. Check back soon." />
        </div>
        <p class="mt-4"><a href={href('/events/')} class="font-semibold text-red-dark hover:text-red underline underline-offset-4">All upcoming events →</a></p>
      </div>
      <div id="faq">
        <SectionHeading eyebrow="Common questions" title="Things people ask." />
        <div class="mt-8 divide-y divide-black/10 border-y border-black/10">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex items-start justify-between gap-4 font-display font-bold text-lg leading-snug">
                {f.q}
                <svg class="chevron w-5 h-5 mt-1 shrink-0 text-red-dark transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="mt-2 text-black-2 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16 bg-red-dark text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-black text-3xl sm:text-4xl">Still not sure where to start?</h2>
      <p class="mt-4 text-lg">Email <a href={`mailto:${site.contactEmail}`} class="font-bold underline underline-offset-4">{site.contactEmail}</a>. A real person will write back and help you find your way in.</p>
    </div>
  </section>
  <ShareLinks title="New here? Start here" />
</Base>
