---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CampaignCard from '../../components/CampaignCard.astro';
import site from '../../data/site.json';
import { href } from '../../lib/paths';

const all = (await getCollection('campaigns')).sort((a, b) => a.data.order - b.data.order);
const active = all.filter((c) => c.data.status === 'active');
const campaigns = active.filter((c) => c.data.kind === 'campaign');
const endorsements = active.filter((c) => c.data.kind === 'endorsement');
const past = all.filter((c) => c.data.status === 'completed');
---
<Base title="Campaigns" description="The campaigns and endorsements Central Sierra Foothills DSA members have voted to put our time and energy behind.">
  <PageHeader eyebrow="Campaigns" title="What we're working on." lede="Everything here was decided by a vote of our members. Pick one that matters to you and jump in." />

  {campaigns.length > 0 && (
    <section class="py-12 sm:py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeading eyebrow="Campaigns" title="Where we put our time and energy." />
        <div class="mt-8 grid md:grid-cols-2 gap-5">
          {campaigns.map((c) => <CampaignCard campaign={c} />)}
        </div>
      </div>
    </section>
  )}

  {endorsements.length > 0 && (
    <section class="py-12 sm:py-16 bg-mist">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeading eyebrow="Endorsements" title="Who and what we stand behind." lede="An endorsement is a vote by members to put the chapter's name behind a candidate or a campaign." />
        <div class="mt-8 grid md:grid-cols-2 gap-5">
          {endorsements.map((c) => <CampaignCard campaign={c} />)}
        </div>
      </div>
    </section>
  )}

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-2xl sm:text-3xl">Have an idea for a campaign?</h2>
      <p class="mt-3 text-lg text-black-2 leading-relaxed">Any member can bring a proposal to the chapter. Come to a branch meeting, talk it over with other members, or email <a href={`mailto:${site.contactEmail}`} class="font-semibold text-red-dark hover:text-red underline underline-offset-4">{site.contactEmail}</a>.</p>
      {past.length > 0 && <p class="mt-4"><a href={href('/archive/')} class="font-semibold text-red-dark hover:text-red underline underline-offset-4">See past campaigns in the archive →</a></p>}
    </div>
  </section>
</Base>
