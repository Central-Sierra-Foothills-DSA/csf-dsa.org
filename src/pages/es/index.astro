---
// Spanish home page. Mirrors src/pages/index.astro; text in src/data/es/.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EventList from '../../components/EventList.astro';
import BranchMap from '../../components/BranchMap.astro';
import UiIcon from '../../components/UiIcon.astro';
import site from '../../data/site.json';
import bridge from '../../assets/photos/foresthill-bridge.jpg';
import tabling from '../../assets/photos/tabling.jpg';
import { upcomingEvents, matches, typeOf, formatShortDate, formatLongDate, formatTime, shortLocation } from '../../lib/events';
import { esText } from '../../lib/i18n';
import { stepsEs, branchEs } from '../../lib/es';
import { href } from '../../lib/paths';

const t = esText.home;
const upcoming = upcomingEvents(new Date());
const nextEvent = upcoming[0];
const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);
const campaigns = (await getCollection('campaigns')).filter((c) => c.data.status === 'active').sort((a, b) => a.data.order - b.data.order);
const nextMeeting = (keywords: string[]) => upcoming.find((e) => typeOf(e) === 'meeting' && matches(e, { keywords }));

const cards = [
  { title: '¿Eres nuevo?', body: 'Qué es DSA, cómo es una primera reunión y cómo unirte.', path: '/es/bienvenida/', icon: 'users' },
  { title: 'Encuentra tu rama', body: 'Cuatro ramas en la sierra. Mira cuál se reúne cerca de ti.', path: '/es/ramas/', icon: 'pin' },
  { title: 'Ven a un evento', body: 'Reuniones, convivios y acciones. No necesitas ser miembro.', path: '/es/eventos/', icon: 'calendar' },
  { title: 'Lo básico', body: 'Qué es el socialismo democrático, en palabras sencillas.', path: '/es/aprender/', icon: 'book' },
] as const;
---
<Base lang="es" title="Inicio" description="Central Sierra Foothills DSA: socialistas democráticos que se organizan en los condados de Placer, Nevada, El Dorado y Sierra, California.">
  <!-- Hero -->
  <section class="relative isolate bg-black text-white overflow-hidden">
    <Image src={bridge} alt="El puente de Foresthill sobre el río American cerca de Auburn, California" widths={[800, 1200, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 w-full h-full object-cover object-[center_40%]" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black via-black/80 to-black/30" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-20 sm:pt-28 sm:pb-28 lg:pt-32 lg:pb-32">
      <p class="flex items-center gap-3 font-semibold tracking-[0.18em] uppercase text-xs sm:text-sm mb-6">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-red" aria-hidden="true"></span>{t.eyebrow}
      </p>
      <h1 class="font-display font-black text-5xl sm:text-6xl lg:text-7xl leading-[0.98] max-w-4xl">{t.tagline}</h1>
      <p class="mt-7 text-lg sm:text-xl text-white/85 max-w-2xl leading-relaxed">{t.intro}</p>
      <div class="mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a href={href('/es/bienvenida/')} class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-red-dark hover:bg-black-1 text-white font-semibold rounded-md text-base sm:text-lg transition-colors">{t.newHere} →</a>
        <a href={href('/es/eventos/')} class="inline-flex items-center justify-center px-7 py-4 border-2 border-white/40 hover:border-white hover:bg-white/5 font-semibold rounded-md text-base sm:text-lg transition-colors">{t.seeEvents}</a>
      </div>
    </div>
    {nextEvent && (
      <a href={nextEvent.url ?? href('/es/eventos/')} target={nextEvent.url ? '_blank' : undefined} rel={nextEvent.url ? 'noopener' : undefined} class="group relative block bg-red-dark hover:bg-black-1 transition-colors">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <span class="font-bold tracking-[0.18em] uppercase text-xs px-2 py-0.5 rounded-sm bg-white text-red-dark">{t.nextUp}</span>
          <span class="font-bold group-hover:underline underline-offset-4" lang="en">{nextEvent.title}</span>
          <span>{formatLongDate(nextEvent.start, 'es')} · {formatTime(nextEvent.start, 'es')}</span>
          {shortLocation(nextEvent, 'es') && <span class="text-white/90">· {shortLocation(nextEvent, 'es')}</span>}
        </div>
      </a>
    )}
  </section>

  <!-- Where to start -->
  <section class="bg-white border-b border-black/10" aria-label="Por dónde empezar">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <ul class="tray tray-narrow grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {cards.map((c) => (
          <li>
            <a href={href(c.path)} class="group flex h-full gap-4 p-5 rounded-xl bg-mist hover:bg-red-dark hover:text-white transition-colors">
              <span class="shrink-0 w-11 h-11 rounded-full bg-red-dark text-white group-hover:bg-white group-hover:text-red-dark flex items-center justify-center transition-colors" aria-hidden="true"><UiIcon name={c.icon} class="w-6 h-6" /></span>
              <span>
                <span class="block font-display font-extrabold text-lg leading-tight">{c.title} <span aria-hidden="true">→</span></span>
                <span class="block mt-1 text-sm leading-relaxed text-black-2 group-hover:text-white">{c.body}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Coming up -->
  <section class="py-16 sm:py-20 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <SectionHeading eyebrow="Próximamente" title="Ven a una reunión. Todos son bienvenidos." lede={esText.events.titlesNote} />
        <a href={href('/es/eventos/')} class="shrink-0 inline-flex items-center gap-2 px-5 py-3 bg-black hover:bg-black-1 text-white font-semibold rounded-md transition-colors">Los {upcoming.length} próximos eventos →</a>
      </div>
      <div class="mt-10">
        <EventList events={upcoming.slice(0, 4)} lang="es" empty={esText.events.empty} />
      </div>
    </div>
  </section>

  <!-- Branches -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Ramas" title="Cuatro condados son mucho terreno. Encuentra la rama cerca de ti." lede="Nos organizamos localmente. La mayoría de las ramas se reúne una vez al mes, y cada una lleva sus propios proyectos." />
      <div class="mt-10 grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <BranchMap lang="es" />
        <ol class="divide-y divide-black/10 border-y border-black/10">
          {branches.map((b, i) => {
            const m = nextMeeting(b.data.keywords);
            return (
              <li class="relative flex gap-4 py-5 group">
                <span class="shrink-0 w-9 h-9 rounded-full bg-red-dark text-white font-display font-black flex items-center justify-center" aria-hidden="true">{i + 1}</span>
                <div class="min-w-0">
                  <h3 class="font-display font-extrabold text-xl leading-tight">
                    <a href={href(`/es/ramas/${b.id}/`)} class="after:absolute after:inset-0 group-hover:text-red-dark">{b.data.name}</a>
                  </h3>
                  <p class="text-sm text-black-2 mt-0.5">{branchEs(b.id).meets}</p>
                  {m && <p class="text-sm font-semibold text-red-dark mt-1">Próxima reunión: {formatShortDate(m.start, 'es')}</p>}
                </div>
                <span class="ml-auto self-center text-red-dark font-semibold" aria-hidden="true">→</span>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <!-- Campaigns -->
  <section class="py-16 sm:py-20 bg-black text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading tone="dark" eyebrow="Lo que hacemos" title="Nuestras campañas y respaldos." lede="Las prioridades a las que nuestros miembros votaron dedicar su tiempo y energía. Los detalles de cada campaña están en inglés." />
      <ul class="tray mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {campaigns.map((c) => (
          <li>
            <a href={href(`/campaigns/${c.id}/`)} hreflang="en" class="block h-full rounded-xl bg-black-1 ring-1 ring-white/10 hover:ring-red-2 p-6 transition-colors">
              <span class="text-[0.7rem] font-bold uppercase tracking-wider text-red-3">{c.data.kind === 'endorsement' ? 'Respaldo' : 'Campaña'}</span>
              <span class="mt-2 block font-display font-extrabold text-xl leading-tight" lang="en">{c.data.title}</span>
              <span class="mt-3 block text-sm font-semibold text-red-3">Leer más (en inglés) →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Get involved -->
  <section class="py-20 sm:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Participa" title="Tres pasos de la curiosidad a la acción." />
        <p class="mt-4 text-lg text-black-2">¿Quieres la versión completa? Lee nuestra <a href={href('/es/bienvenida/')} class="font-semibold text-red-dark hover:text-red underline underline-offset-4">guía de bienvenida</a>.</p>
        <ol class="mt-10 space-y-8">
          {stepsEs.slice(0, 3).map((s, i) => (
            <li class="flex gap-5">
              <span class="shrink-0 w-11 h-11 rounded-full bg-red-dark text-white font-display font-black text-lg flex items-center justify-center" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="font-display font-bold text-xl sm:text-2xl leading-tight">{s.title}</h3>
                <p class="mt-2 text-black-1 leading-relaxed">{s.body}</p>
                <a href={s.cta.href} target={s.cta.external ? '_blank' : undefined} rel={s.cta.external ? 'noopener' : undefined} class="mt-3 inline-flex items-center gap-1.5 font-semibold text-red-dark hover:text-red underline underline-offset-4 decoration-2">{s.cta.label} {s.cta.external ? '↗' : '→'}</a>
              </div>
            </li>
          ))}
        </ol>
        <div class="mt-12 p-6 rounded-xl bg-mist">
          <h3 class="font-display font-bold text-lg">¿Preguntas? Escríbenos.</h3>
          <p class="mt-2 text-sm"><a href={`mailto:${site.contactEmail}`} class="font-semibold hover:text-red-dark">{site.contactEmail}</a> · <a href={site.social.instagram} target="_blank" rel="noopener" class="font-semibold hover:text-red-dark">Instagram</a> · <a href={site.social.facebook} target="_blank" rel="noopener" class="font-semibold hover:text-red-dark">Facebook</a> · <a href={site.social.reddit} target="_blank" rel="noopener" class="font-semibold hover:text-red-dark">Reddit</a></p>
        </div>
      </div>
      <Image src={tabling} alt="Un miembro del capítulo conversa con gente que pasa junto a una mesa informativa al aire libre" widths={[400, 720]} sizes="(min-width: 1024px) 440px, 100vw" class="lg:col-span-5 w-full h-48 sm:h-96 object-cover rounded-xl shadow-md ring-1 ring-black/10" />
    </div>
  </section>
</Base>
