---
// Spanish events page. Mirrors src/pages/events.astro. Event titles and
// descriptions come from the calendar and stay in English.
import EventSchema from '../../components/EventSchema.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventList from '../../components/EventList.astro';
import CalendarSubscribe from '../../components/CalendarSubscribe.astro';
import site from '../../data/site.json';
import { upcomingEvents, typeOf, EVENT_TYPES, EVENT_TYPES_ES, eventsFetchedAt, formatShortDate } from '../../lib/events';
import { esText } from '../../lib/i18n';

const upcoming = upcomingEvents(new Date());
const present = EVENT_TYPES.filter((t) => upcoming.some((e) => typeOf(e) === t.key));
const count = (key: string) => upcoming.filter((e) => typeOf(e) === key).length;

// Same no-JavaScript filter as the English page.
const filterCss = present
  .map((t) => `
.events-filter:has(input[value="${t.key}"]:checked) ~ .events-list .event:not([data-type="${t.key}"]) { display: none; }
.events-filter:has(input[value="${t.key}"]:checked) ~ .events-list .event-day:not(:has(.event[data-type="${t.key}"])) { display: none; }`)
  .join('\n');
---
<Base lang="es" title="Eventos" description="Próximas reuniones, convivios, acciones y capacitaciones de Central Sierra Foothills DSA.">
  <PageHeader eyebrow="Eventos" title="Lo que viene." lede="Reuniones de rama, convivios, acciones y reuniones del gobierno local donde nuestras campañas están en la agenda. No tienes que ser miembro para venir." />

  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="mb-6 rounded-lg bg-mist px-4 py-3 text-sm text-black-1">{esText.events.titlesNote} Las fechas, horas y tipos de evento están en español.</p>
      <style set:html={filterCss}></style>

      <fieldset class="events-filter">
        <legend class="text-xs font-semibold tracking-[0.18em] uppercase text-black-2 mb-3">Mostrar</legend>
        <div class="flex flex-wrap gap-2">
          <label class="chip"><input type="radio" name="type" value="all" class="sr-only" checked /> Todo <span class="chip-count">{upcoming.length}</span></label>
          {present.map((t) => (
            <label class="chip"><input type="radio" name="type" value={t.key} class="sr-only" /> {EVENT_TYPES_ES[t.key].plural} <span class="chip-count">{count(t.key)}</span></label>
          ))}
        </div>
      </fieldset>

      <div class="events-list mt-8">
        <EventList events={upcoming} lang="es" empty={esText.events.empty} />
      </div>

      <div class="mt-10"><CalendarSubscribe lang="es" /></div>

      <div class="mt-4 p-6 rounded-xl bg-mist flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="font-display font-bold text-lg">Confirma tu asistencia y ve todos los detalles</h2>
          <p class="text-sm text-black-2 mt-1">Cada evento lleva a su página en nuestro calendario de Solidarity Tech (en inglés), donde puedes confirmar tu asistencia y recibir enlaces de Zoom.</p>
        </div>
        <a href={site.links.fullCalendar} target="_blank" rel="noopener" class="shrink-0 inline-flex items-center justify-center px-5 py-3 bg-black hover:bg-black-1 text-white font-semibold rounded-md transition-colors">Abrir el calendario ↗</a>
      </div>

      <p class="mt-6 text-sm text-black-2">Las horas son del Pacífico. Esta lista se actualiza sola desde el calendario (última actualización: {formatShortDate(eventsFetchedAt, 'es')}).</p>
    </div>
  </section>
  <ShareLinks title="Próximos eventos" lang="es" />
  <EventSchema events={upcoming} />
</Base>
