---
// Spanish Learn page. Mirrors src/pages/learn.astro; glossary and quotes in src/data/es/shared.json.
import ShareLinks from '../../components/ShareLinks.astro';
import Base from '../../layouts/Base.astro';
import Fold from '../../components/Fold.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import resources from '../../data/resources.json';
import { glossaryEs, quotesEs, quotesNote } from '../../lib/es';
import { href } from '../../lib/paths';

const reach = [
  { label: 'El gobierno', note: 'Todos ya tenemos voz.', now: true },
  { label: 'El trabajo', note: '¿Por qué la democracia debería quedarse en la puerta?', now: false },
  { label: 'Lo que todos necesitamos', note: 'Como la salud, la vivienda y la energía.', now: false },
];
const practice = [
  { title: 'Atención médica para todos', icon: 'M24 40s-14-8.5-14-18a8 8 0 0 1 14-5.3A8 8 0 0 1 38 22c0 9.5-14 18-14 18z M24 20v10 M19 25h10' },
  { title: 'Vivienda que la gente pueda pagar', icon: 'M8 22 24 9l16 13 M12 19v20h24V19 M20 39V28h8v11' },
  { title: 'Sindicatos fuertes', icon: 'M16 18a5 5 0 1 0 0-.1z M32 18a5 5 0 1 0 0-.1z M7 39c0-6 4-10 9-10s9 4 9 10 M23 39c0-6 4-10 9-10s9 4 9 10' },
  { title: 'Servicios públicos que de verdad sean públicos', icon: 'M6 16 24 7l18 9z M10 20v15 M19 20v15 M29 20v15 M38 20v15 M6 40h36' },
];
const freedoms = ['Libertad de expresión', 'Elecciones libres', 'El derecho a organizarse'];

// Accent-free ids for the glossary links: "Socialismo democrático" -> "socialismo-democratico".
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const groupInfo = [
  { id: 'ideas', title: 'Las grandes ideas', blurb: 'Las ideas detrás de lo que hacemos y por qué.' },
  { id: 'organizing', title: 'Trabajadores y organización', blurb: 'Cómo la gente trabajadora construye poder en conjunto.' },
  { id: 'policy', title: 'Por lo que luchamos', blurb: 'Grandes propuestas de las que vas a oír hablar.' },
  { id: 'dsa', title: 'Cómo funciona DSA', blurb: 'Las palabras para cómo funciona nuestra organización.' },
];
const groups = groupInfo.map((g) => ({ ...g, terms: glossaryEs.filter((t) => t.category === g.id) }));
const [featured, ...otherQuotes] = [...quotesEs].sort((a, b) => b.text.length - a.text.length);

// Reading list: these sites are in English, so the blurbs say so.
const blurbs: Record<string, string> = {
  'DSA National': 'La organización nacional: plataforma, campañas y directorio de capítulos.',
  'Join DSA': 'Hazte miembro con cuotas. Escoge nuestro capítulo al inscribirte.',
  'California DSA': 'Coordinación estatal entre los capítulos de California.',
  'Jacobin': 'Política y análisis socialista.',
};
---
<Base lang="es" title="Aprender" description="Qué significa el socialismo democrático, un glosario en palabras sencillas y dónde leer más.">
  <PageHeader eyebrow="Aprender" title="Lo básico, en palabras sencillas." lede="Qué significa el socialismo democrático, las palabras que vas a oír en las reuniones y dónde leer más. Sin tarea." />

  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="La gran idea" title="¿Qué es el socialismo democrático?" />
      <p class="mt-8 max-w-4xl font-display font-bold text-2xl sm:text-3xl lg:text-4xl leading-snug tracking-tight">
        Los socialistas democráticos creemos que tanto la economía como la sociedad deben funcionar de forma democrática, <span class="text-red-dark">para cubrir las necesidades de la gente y no para darle ganancias a unos pocos.</span>
      </p>

      <h3 class="mt-14 font-display font-extrabold text-xl">Democracia de punta a punta</h3>
      <ol class="mt-5 grid md:grid-cols-3 gap-4 md:gap-0">
        {reach.map((r, i) => (
          <li class="relative flex md:block">
            <div class:list={['flex-1 h-full rounded-xl p-6', i < reach.length - 1 && 'md:mr-8', r.now ? 'bg-black text-white' : 'border-2 border-dashed border-red bg-red-4/30']}>
              <span class:list={['text-xs font-semibold tracking-[0.18em] uppercase', r.now ? 'text-red-2' : 'text-red-dark']}>{r.now ? 'Hoy' : 'Lo que sigue'}</span>
              <p class="mt-1 font-display font-black text-2xl leading-tight">{r.label}</p>
              <p class:list={['mt-2 leading-relaxed', r.now ? 'text-white/80' : 'text-black-1']}>{r.note}</p>
            </div>
            {i < reach.length - 1 && (
              <span class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 w-8 justify-center text-red-dark" aria-hidden="true">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 6l6 6-6 6M5 12h14" /></svg>
              </span>
            )}
          </li>
        ))}
      </ol>
      <p class="mt-8 max-w-3xl text-lg leading-relaxed">
        La mayoría ya creemos en la democracia cuando se trata del gobierno: todos tenemos voz. El socialismo democrático pregunta por qué eso debería quedarse en la puerta del trabajo, o en las cosas de las que todos dependemos.
        Cuando unos pocos dueños toman esas decisiones para ganar dinero, los demás vivimos con las consecuencias. <strong>Creemos que deben decidir las personas que hacen el trabajo y que viven en la comunidad.</strong>
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="En la práctica" title="Por lo que luchamos." />
      <ul class="tray mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {practice.map((p) => (
          <li class="bg-white rounded-xl p-6 ring-1 ring-black/10 border-t-4 border-red">
            <span class="w-16 h-16 rounded-full bg-red-dark text-white flex items-center justify-center" aria-hidden="true">
              <svg class="w-9 h-9" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon} /></svg>
            </span>
            <p class="mt-5 font-display font-extrabold text-xl leading-tight">{p.title}</p>
          </li>
        ))}
      </ul>
      <p class="mt-8 max-w-3xl text-lg leading-relaxed">También significa construir organizaciones, como esta, donde la gente común practica cómo dirigir las cosas en conjunto.</p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-black text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <p class="font-semibold tracking-[0.18em] uppercase text-xs text-red-2">Lo que no significa</p>
          <h2 class="mt-3 font-display font-black text-4xl sm:text-5xl leading-[1.02]">Más democracia,<br />no menos.</h2>
          <p class="mt-5 text-lg text-white/80 leading-relaxed max-w-xl">No significa renunciar a las libertades. Estas son la base:</p>
        </div>
        <ul class="lg:col-span-5 flex flex-wrap gap-3">
          {freedoms.map((f) => <li class="px-5 py-3 rounded-full bg-red-dark font-display font-bold text-lg">{f}</li>)}
        </ul>
      </div>
      <div class="mt-16 border-t border-white/15 pt-14 grid lg:grid-cols-12 gap-10">
        <figure class="lg:col-span-7">
          <span class="block font-display font-black text-red text-8xl leading-[0.5] h-10" aria-hidden="true">“</span>
          <blockquote class="font-display font-extrabold text-2xl sm:text-3xl leading-snug">{featured.text}</blockquote>
          <figcaption class="mt-5 flex items-center gap-3"><span class="h-1 w-10 bg-red" aria-hidden="true"></span><span><span class="font-semibold">{featured.who}</span> <span class="text-white/60">· {featured.where}</span></span></figcaption>
        </figure>
        <div class="lg:col-span-5 space-y-8">
          {otherQuotes.map((q) => (
            <figure class="pl-5 border-l-4 border-red">
              <blockquote class="font-display font-bold text-xl leading-snug">“{q.text}”</blockquote>
              <figcaption class="mt-3 text-sm"><span class="font-semibold">{q.who}</span> <span class="text-white/60">· {q.where}</span></figcaption>
            </figure>
          ))}
          <p class="text-sm text-white/60">{quotesNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="glosario" class="py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Glosario" title="Palabras que vas a oír en las reuniones." lede="Nadie nace sabiéndolas. Pregunta en cualquier reunión y alguien te las explica con gusto." />
        <p class="flex items-baseline gap-3"><span class="font-display font-black text-6xl text-red-dark leading-none">{glossaryEs.length}</span><span class="font-display font-bold text-lg leading-tight">palabras en<br />{groups.length} grupos</span></p>
      </div>
      <nav id="indice" aria-label="Índice del glosario" class="hidden md:block mt-10 scroll-mt-24 rounded-2xl bg-black text-white p-6 sm:p-8">
        <p class="font-semibold tracking-[0.18em] uppercase text-xs text-red-2">Ve a una palabra</p>
        <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {groups.map((g, i) => (
            <div>
              <a href={`#grupo-${g.id}`} class="group flex items-baseline gap-2 hover:text-red-2">
                <span class="font-display font-black text-red-2 text-sm">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display font-extrabold text-lg leading-tight group-hover:underline underline-offset-4">{g.title}</span>
              </a>
              <ul class="mt-3 space-y-1.5 border-l border-white/15 pl-4">
                {g.terms.map((t) => <li><a href={`#termino-${slug(t.term)}`} class="text-white/75 hover:text-white hover:underline underline-offset-4">{t.term}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
      </nav>
      {groups.map((g, i) => (
        <div id={`grupo-${g.id}`} class="mt-8 sm:mt-20 scroll-mt-24 grid lg:grid-cols-12 gap-4 lg:gap-12 border-t-4 border-black pt-6 sm:pt-8">
          <header class="lg:col-span-4">
            <div class="lg:sticky lg:top-24">
              <span class="block font-display font-black text-5xl sm:text-8xl leading-none outline-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-display font-black text-3xl leading-tight">{g.title}</h3>
              <p class="mt-2 text-black-2 leading-relaxed">{g.blurb}</p>
              <a href="#indice" class="hidden md:inline-block mt-4 text-sm font-semibold text-red-dark hover:text-red underline underline-offset-4">↑ Volver al índice</a>
            </div>
          </header>
          <div class="lg:col-span-8"><Fold id={`words-${g.id}`} label={`Ver las ${g.terms.length} palabras`}>
          <dl class="divide-y divide-black/10">
            {g.terms.map((t) => (
              <div id={`termino-${slug(t.term)}`} class="term scroll-mt-24 relative -ml-4 pl-4 grid sm:grid-cols-[13rem_1fr] gap-x-8 gap-y-2 py-6">
                <dt class="font-display font-black text-2xl leading-tight">{t.term}</dt>
                <dd class="text-lg text-black-1 leading-relaxed">{t.definition}</dd>
              </div>
            ))}
          </dl>
          </Fold></div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="Sigue aprendiendo" title="Dónde leer más." lede="Estos sitios están en inglés." />
      <ul class="tray tray-narrow mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {resources.map((r) => (
          <li>
            <a href={r.href} target="_blank" rel="noopener" hreflang="en" class="group h-full flex flex-col p-6 bg-white rounded-xl ring-1 ring-black/10 hover:bg-red-dark hover:ring-red-dark hover:text-white transition-colors">
              <span class="font-display font-extrabold text-xl" lang="en">{r.label}</span>
              <span class="mt-2 flex-1 text-sm text-black-2 group-hover:text-white/90 leading-relaxed">{blurbs[r.label] ?? ''}</span>
              <span class="mt-5 text-sm font-semibold text-red-dark group-hover:text-white">Ir al sitio ↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <ShareLinks title="Lo básico del socialismo democrático" lang="es" />
</Base>

<style>
  .outline-num { color: transparent; -webkit-text-stroke: 2px var(--color-red-dark); }
  .term:target { background: color-mix(in srgb, var(--color-red-4) 45%, transparent); }
  .term:target::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--color-red); }
</style>
