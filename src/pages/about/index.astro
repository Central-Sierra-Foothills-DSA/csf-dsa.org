---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BranchMap from '../../components/BranchMap.astro';
import site from '../../data/site.json';
import groups from '../../data/working-groups.json';
import partners from '../../data/partners.json';
import { href } from '../../lib/paths';

const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);

// Quick facts. Each one is stated elsewhere on this page.
const facts = [
  { n: site.founded, label: 'founded in Auburn' },
  { n: `~${site.approxMembers}`, label: 'members' },
  { n: String(branches.length), label: 'local branches' },
  { n: String(site.counties.length), label: 'counties' },
  { n: '0', label: 'paid staff' },
];

// From the roots up: each layer exists to support the one above it.
const layers = [
  { name: 'Members', body: 'Everything else exists to support the people in the room. Any member can bring a proposal, join a working group, or run for a role.' },
  { name: 'Branches', body: 'Local groups where you meet your neighbors face to face. Branches run their own meetings and projects.' },
  { name: 'The chapter', body: 'All four counties together. The chapter handles anything that crosses county lines and supports the branches.' },
  { name: 'DSA National', body: 'More than a hundred thousand members across the country. Chapter delegates set national priorities at convention.' },
];
// Bar width and color for each layer, roots (widest) to top.
const layerStyle = [
  'lg:w-full bg-black text-white',
  'lg:w-[88%] bg-red text-white',
  'lg:w-[76%] bg-red-3 text-black',
  'lg:w-[64%] bg-red-4 text-black',
];

// Officer duties, summarized from Article V of the bylaws.
const roles = [
  { name: 'Co-Chairs (two)', body: 'Preside over chapter and steering committee meetings, speak publicly for the chapter, and coordinate the day-to-day work of branches and committees.' },
  { name: 'Secretary', body: 'Answers chapter correspondence, keeps the membership list and meeting minutes, and keeps us in touch with DSA National.' },
  { name: 'Treasurer', body: 'Looks after the chapter’s funds and financial records, prepares the annual budget, and reports on finances to the membership.' },
  { name: 'Social Media Coordinator', body: 'Manages the chapter’s social media.' },
  { name: 'Branch chairs', body: 'Each branch chair holds a seat on the steering committee, so every branch has a voice in chapter decisions.' },
];

const decide = [
  { title: 'Anyone can propose', body: 'Any member can bring a motion. We discuss it together at a chapter meeting, where questions and amendments are welcome. Guests can speak too.' },
  { title: 'Everyone votes', body: 'After the meeting, every member in good standing gets an anonymous online ballot. You don’t have to be in the room to have a say.' },
  { title: 'Local stays local', body: 'The whole chapter votes on anything that spans counties, such as congressional races and chapter money. Branches handle local decisions.' },
];

const linkClass = 'font-semibold text-red-dark hover:text-red underline underline-offset-4 decoration-2';
---
<Base title="About us" description="Who Central Sierra Foothills DSA is, what we believe, and how the chapter and its branches are organized.">
  <PageHeader eyebrow="About" title="Who we are and how we work." lede="A member-run chapter of the Democratic Socialists of America in the Sierra foothills. No paid staff, no big donors. Just neighbors organizing together." />

  <!-- Who we are -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
        <div class="lg:col-span-7">
          <SectionHeading eyebrow="Who we are" title="A socialist chapter for the foothills." />
          <div class="mt-6 space-y-5 text-lg leading-relaxed">
            <p>
              Central Sierra Foothills DSA is the local chapter of the Democratic Socialists of America, the largest socialist organization in the United States.
              Our members live and work in {site.counties.slice(0, -1).join(', ')}, and {site.counties.at(-1)} counties.
            </p>
            <p>
              The chapter was founded in Auburn in {site.founded}. It began that spring as a reading group that came together around the Bernie Sanders campaign and a local Green New Deal.
              Today we have about {site.approxMembers} members and branches in Grass Valley / Nevada City, Auburn, Placerville, and Roseville.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={href('/new-members/')} class="inline-flex items-center px-5 py-3 bg-red hover:bg-red-dark text-white font-semibold rounded-md transition-colors">New here? Start here</a>
            <a href={href('/learn/')} class="inline-flex items-center px-5 py-3 bg-mist hover:bg-black-4/60 font-semibold rounded-md transition-colors">What is democratic socialism?</a>
          </div>
        </div>
        <div class="lg:col-span-5 rounded-2xl bg-black text-white p-7 sm:p-8 self-start">
          <p class="text-xs font-semibold tracking-[0.18em] uppercase text-red-2">What we fight for</p>
          <ul class="mt-4 space-y-3">
            {['Health care for everyone', 'Housing as a human right', 'Strong unions', 'An end to mass surveillance in our towns'].map((t) => (
              <li class="flex gap-3 items-start font-display font-bold text-xl leading-snug">
                <span class="mt-2 w-2.5 h-2.5 shrink-0 rounded-full bg-red" aria-hidden="true"></span>{t}
              </li>
            ))}
          </ul>
          <p class="mt-5 text-white/70 leading-relaxed">Things that make working people's lives better.</p>
        </div>
      </div>

      <dl class="mt-14 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 border-y-4 border-black divide-x divide-black/10">
        {facts.map((f, i) => (
          <div class:list={['px-4 sm:px-6 py-6', i >= 2 && 'border-t border-black/10 sm:border-t-0', i >= 3 && 'sm:border-t lg:border-t-0']}>
            <dt class="sr-only">{f.label}</dt>
            <dd class="font-display font-black text-4xl sm:text-5xl text-red leading-none">{f.n}</dd>
            <dd class="mt-2 font-semibold text-black-1">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Bylaws quote -->
  <section class="py-14 sm:py-20 bg-red text-white overflow-hidden">
    <figure class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="absolute -top-10 sm:-top-14 left-0 sm:-left-2 font-display font-black text-[10rem] sm:text-[14rem] leading-none text-white/15 select-none" aria-hidden="true">“</span>
      <blockquote class="relative font-display font-bold text-2xl sm:text-3xl lg:text-[2.1rem] leading-snug">
        Our conception of socialism is a profoundly democratic one. It is rooted in the belief that human beings should be free to develop to their fullest potential, that public policies should be determined not by wealth but by popular participation, and that individual liberties should be carefully safeguarded.
      </blockquote>
      <figcaption class="relative mt-6 flex items-center gap-3 font-semibold">
        <span class="h-1 w-10 bg-white" aria-hidden="true"></span>
        <span>From our <a href={href('/about/bylaws/')} class="underline underline-offset-4 hover:text-black">chapter bylaws</a>, Article II</span>
      </figcaption>
    </figure>
  </section>

  <!-- Structure -->
  <section id="structure" class="py-14 sm:py-20 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="How we're organized" title="Built from the roots up." lede="DSA runs bottom-up. Members set chapter priorities, and chapter delegates set national ones." />
        <p class="mt-6 flex items-center gap-3 font-semibold text-red-dark">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7" /></svg>
          Priorities flow up from members
        </p>
      </div>
      <!-- Members first in the list, drawn at the bottom as the foundation. -->
      <ol class="lg:col-span-8 flex flex-col-reverse items-center gap-2.5">
        {layers.map((l, i) => (
          <li class:list={['w-full rounded-xl px-6 py-5 sm:flex sm:items-baseline sm:gap-6', layerStyle[i]]}>
            <span class="flex items-baseline gap-3 sm:w-44 shrink-0">
              <span class="font-display font-black text-sm opacity-70" aria-hidden="true">{i + 1}</span>
              <span class="font-display font-black text-xl">{l.name}</span>
            </span>
            <span class="block mt-1 sm:mt-0 leading-relaxed opacity-90">{l.body}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Steering committee -->
  <section id="steering-committee" class="py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-end">
        <div class="lg:col-span-6">
          <SectionHeading eyebrow="Steering committee" title="Who keeps things running." />
          <div class="mt-6 space-y-4 text-lg leading-relaxed">
            <p>
              The steering committee is the chapter's five officers plus the chair of each branch. Officers are elected by the membership every year.
              Nominations are always open, and any member in good standing can run.
            </p>
            <p>
              The committee carries out what members decide and handles business between meetings. It answers to the membership, not the other way around.
              Our bylaws call it the Executive Committee.
            </p>
          </div>
        </div>
        <!-- The sum -->
        <div class="lg:col-span-6 flex flex-wrap items-center gap-3 sm:gap-4 font-display" aria-label={`Five officers plus ${branches.length} branch chairs make up the steering committee`}>
          <span class="rounded-xl bg-black text-white px-5 py-4 text-center"><span class="block font-black text-4xl leading-none">5</span><span class="block mt-1 text-sm font-bold">officers</span></span>
          <span class="font-black text-3xl text-red" aria-hidden="true">+</span>
          <span class="rounded-xl bg-black text-white px-5 py-4 text-center"><span class="block font-black text-4xl leading-none">{branches.length}</span><span class="block mt-1 text-sm font-bold">branch chairs</span></span>
          <span class="font-black text-3xl text-red" aria-hidden="true">=</span>
          <span class="rounded-xl bg-red text-white px-5 py-4 text-center"><span class="block font-black text-4xl leading-none">{5 + branches.length}</span><span class="block mt-1 text-sm font-bold">steering committee</span></span>
        </div>
      </div>

      <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {roles.map((r, i) => (
          <li class:list={['rounded-xl p-6', i === roles.length - 1 ? 'bg-red text-white' : 'bg-mist']}>
            <p class:list={['text-xs font-semibold tracking-[0.16em] uppercase', i === roles.length - 1 ? 'text-white/80' : 'text-red-dark']}>
              {i === roles.length - 1 ? 'One per branch' : 'Officer'}
            </p>
            <h3 class="mt-1 font-display font-extrabold text-xl">{r.name}</h3>
            <p class:list={['mt-2 leading-relaxed', i === roles.length - 1 ? 'text-white/90' : 'text-black-2']}>{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Branches and working groups -->
  <section id="branches-and-groups" class="py-14 sm:py-20 bg-mist">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-5">
          <SectionHeading eyebrow="Branches" title="Local, and in charge of local." />
          <p class="mt-6 text-lg leading-relaxed">
            A branch is a group of at least five members organized around a town or area. Branches hold their own meetings, speak for DSA locally, and can endorse in local races on their own.
            Each branch chooses a chair, who represents the branch on the steering committee.
          </p>
          <ol class="mt-6 space-y-2">
            {branches.map((b, i) => (
              <li>
                <a href={href(`/branches/${b.id}/`)} class="group flex items-center gap-3 p-3 rounded-lg bg-white ring-1 ring-black/10 hover:ring-red transition-colors">
                  <span class="w-8 h-8 shrink-0 rounded-full bg-red text-white font-display font-black text-sm flex items-center justify-center" aria-hidden="true">{i + 1}</span>
                  <span class="font-display font-bold flex-1 group-hover:text-red-dark">{b.data.name}</span>
                  <span class="text-red-dark" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-black-2">No branch near you yet? We'd love to see one in Truckee and Tahoe. <a href={`mailto:${site.contactEmail}`} class={linkClass}>Email us</a> and we'll help you start one.</p>
        </div>
        <div class="lg:col-span-7">
          <BranchMap />
        </div>
      </div>

      <div class="mt-16 sm:mt-20">
        <SectionHeading eyebrow="Working groups" title="Teams that cross county lines." lede="Working groups take on one kind of work for the whole chapter. They're open to every member, and anyone can start one." />
        <dl class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {groups.map((g) => (
            <div class="bg-white rounded-xl p-6 ring-1 ring-black/10 border-t-4 border-red">
              <dt class="font-display font-extrabold text-xl">{g.name}</dt>
              <dd class="mt-2 text-black-2 leading-relaxed">{g.description}</dd>
            </div>
          ))}
          <div class="rounded-xl p-6 border-2 border-dashed border-red/50 flex flex-col justify-center">
            <dt class="font-display font-extrabold text-xl">Your idea here</dt>
            <dd class="mt-2 text-black-2 leading-relaxed">Anyone can start a working group. <a href={`mailto:${site.contactEmail}`} class={linkClass}>Tell us what you have in mind.</a></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- How we decide -->
  <section id="decisions" class="py-14 sm:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading eyebrow="How we decide" title="One member, one vote." />
      <ol class="mt-10 grid md:grid-cols-3 gap-4 md:gap-0">
        {decide.map((d, i) => (
          <li class="relative flex md:block">
            <div class:list={['flex-1 h-full rounded-xl p-6', i < decide.length - 1 && 'md:mr-10', i === 2 ? 'bg-black text-white' : 'bg-mist']}>
              <span class:list={['font-display font-black text-5xl leading-none', i === 2 ? 'text-red-2' : 'text-red']}>{i + 1}</span>
              <h3 class="mt-3 font-display font-extrabold text-xl">{d.title}</h3>
              <p class:list={['mt-2 leading-relaxed', i === 2 ? 'text-white/80' : 'text-black-2']}>{d.body}</p>
            </div>
            {i < decide.length - 1 && (
              <span class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 w-10 justify-center text-red" aria-hidden="true">
                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 6l6 6-6 6M5 12h14" /></svg>
              </span>
            )}
          </li>
        ))}
      </ol>
      <div class="mt-8 rounded-xl ring-1 ring-black/10 p-6 sm:flex sm:items-center sm:gap-6">
        <p class="text-lg leading-relaxed flex-1">
          The chapter holds a General Meeting every year to elect officers, and at least four regular chapter meetings a year. Most branches meet monthly.
        </p>
        <a href={href('/about/bylaws/')} class="mt-4 sm:mt-0 inline-flex shrink-0 items-center px-5 py-3 bg-black hover:bg-red text-white font-semibold rounded-md transition-colors">Read the bylaws →</a>
      </div>
    </div>
  </section>

  {partners.length > 0 && (
    <section id="partners" class="py-14 sm:py-20 bg-mist">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeading eyebrow="Allies" title="Organizations we work with." />
        <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {partners.map((p: { name: string; url?: string; blurb?: string }) => (
            <li class="bg-white rounded-xl p-5 ring-1 ring-black/10">
              <h3 class="font-display font-bold text-lg">{p.url ? <a href={p.url} target="_blank" rel="noopener" class="hover:text-red-dark">{p.name} ↗</a> : p.name}</h3>
              {p.blurb && <p class="mt-1 text-sm text-black-2 leading-relaxed">{p.blurb}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="py-14 sm:py-16 bg-black text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-black text-3xl sm:text-4xl">Questions about the chapter?</h2>
      <p class="mt-4 text-lg text-white/80">Email <a href={`mailto:${site.contactEmail}`} class="font-semibold text-red-3 hover:text-white underline underline-offset-4">{site.contactEmail}</a> or come to a meeting and ask in person.</p>
      <a href={href('/events/')} class="mt-8 inline-flex items-center px-6 py-3.5 bg-red hover:bg-red-dark text-white font-semibold rounded-md transition-colors">See upcoming events</a>
    </div>
  </section>
</Base>
