---
// Layout for print documents (the new member packet). No nav or footer; sized for
// US Letter. `npm run packet` prints a page that uses it to PDF with headless Chrome.
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.orgName}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="print-doc">
    <slot />
  </body>
</html>

<style is:global>
  @page {
    size: letter;
    margin: 0.65in 0.7in 0.75in;
    @bottom-left {
      content: "Central Sierra Foothills DSA · New member packet";
      font-family: "Manifold DSA", sans-serif; font-size: 8pt; color: #8c8989;
    }
    @bottom-right {
      content: counter(page);
      font-family: "Manifold DSA", sans-serif; font-size: 9pt; font-weight: 700; color: #c4161d;
    }
  }
  /* Full-bleed pages: cover, part dividers, back cover. */
  @page bleed {
    margin: 0;
    @bottom-left { content: none; }
    @bottom-right { content: none; }
  }

  .print-doc {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    font-size: 10.5pt;
    line-height: 1.5;
  }
  .bleed {
    page: bleed;
    width: 8.5in;
    height: 11in;
    break-before: page;
    break-after: page;
    overflow: hidden;
    position: relative;
  }
  .bleed:first-child { break-before: auto; }
  .new-page { break-before: page; }
  .keep { break-inside: avoid; }
  h2, h3, h4 { break-after: avoid; }

  /* Writing lines for the workbook. */
  .write-lines {
    background-image: linear-gradient(to bottom, transparent calc(0.36in - 1px), #c1c0bf calc(0.36in - 1px));
    background-size: 100% 0.36in;
  }
  .checkbox {
    width: 0.16in; height: 0.16in;
    border: 1.5px solid #605c5c; border-radius: 3px;
    display: inline-block; flex-shrink: 0;
  }

  /* On screen, show the document at page width so it can be previewed. */
  @media screen {
    html { background: #c1c0bf; }
    .print-doc {
      width: 8.5in; margin: 0.4in auto; background: white;
      box-shadow: 0 4px 30px rgb(0 0 0 / 0.25);
    }
    .print-doc > .flow { padding: 0.65in 0.7in 0.75in; }
    .new-page { margin-top: 0.6in; padding-top: 0.6in; border-top: 2px dashed #c1c0bf; }
  }
</style>
