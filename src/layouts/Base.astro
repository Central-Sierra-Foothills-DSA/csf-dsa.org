---
import '../styles/global.css';
import site from '../data/site.json';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import fontRegular from '../assets/fonts/ManifoldDSA-Regular.woff2?url';
import fontHeavy from '../assets/fonts/ManifoldDSA-Heavy.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title: pageTitle, description = site.intro } = Astro.props;
// Inner pages pass a short title ("Events"); the chapter name is appended here.
const title = pageTitle ? `${pageTitle} — ${site.orgName}` : `${site.orgName} — Democratic Socialists of America`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/images/og.png`, Astro.site ?? 'https://csf-dsa.org').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#231F20" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/images/apple-touch-icon.png`} />
    <link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontHeavy} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-red focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:font-semibold">
      Skip to content
    </a>
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
