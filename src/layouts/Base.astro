---
import '../styles/global.css';
import site from '../data/site.json';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import fontRegular from '../assets/fonts/ManifoldDSA-Regular.woff2?url';
import fontHeavy from '../assets/fonts/ManifoldDSA-Heavy.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title: pageTitle, description = site.intro } = Astro.props;
// Inner pages pass a short title ("Events"); the chapter name is appended here.
const title = pageTitle ? `${pageTitle} — ${site.orgName}` : `${site.orgName} — Democratic Socialists of America`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Set by the deploy workflow when this build is a pull request preview.
// Previews get a banner and are hidden from search engines.
const previewPr = import.meta.env.PUBLIC_PREVIEW_PR as string | undefined;
const ogImage = new URL(`${base}/images/og.png`, Astro.site ?? 'https://csf-dsa.org').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {previewPr && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#231F20" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/images/apple-touch-icon.png`} />
    <link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontHeavy} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-red focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:font-semibold">
      Skip to content
    </a>
    {previewPr && (
      <div class="bg-black-1 text-white text-sm">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="font-bold uppercase tracking-wider text-[0.7rem] px-2 py-0.5 rounded-sm bg-white text-black">Preview</span>
          <span>This is a preview of <a href={`${site.links.github}/pull/${previewPr}`} class="font-semibold underline underline-offset-4 hover:text-red-3">pull request #{previewPr}</a>, not the live site.</span>
        </div>
      </div>
    )}
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
