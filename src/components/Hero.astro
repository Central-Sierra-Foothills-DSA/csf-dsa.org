---
import config from '../data/site-config.json';
---
<section class="relative min-h-screen flex items-center justify-center bg-charcoal text-white overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 20% 50%, var(--color-dsa-red) 0%, transparent 50%), radial-gradient(circle at 80% 20%, var(--color-sierra-gold) 0%, transparent 40%);"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-16">
    <p class="text-dsa-red font-semibold tracking-widest uppercase text-sm mb-4">Democratic Socialists of America</p>

    <h1 class="font-heading font-bold text-5xl sm:text-6xl lg:text-7xl leading-tight mb-6">
      Central Sierra<br />
      <span class="text-dsa-red">Foothills</span> DSA
    </h1>

    <p class="text-xl sm:text-2xl text-white/70 max-w-2xl mx-auto mb-4 leading-relaxed">
      {config.tagline}
    </p>

    <p class="text-base text-white/50 mb-10">
      Serving {config.counties.join(', ')} counties
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#get-involved"
        class="px-8 py-4 bg-dsa-red hover:bg-dsa-red-dark text-white font-semibold rounded-lg text-lg transition-colors"
      >
        Get Involved
      </a>
      <a
        href="#about"
        class="px-8 py-4 border-2 border-white/30 hover:border-white/60 text-white font-semibold rounded-lg text-lg transition-colors"
      >
        Learn More
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
