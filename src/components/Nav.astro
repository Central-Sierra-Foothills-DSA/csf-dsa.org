---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import badge from '../assets/logos/csf-dsa-white.png';
import { href, currentPath } from '../lib/paths';

const links = [
  { path: '/about/', label: 'About' },
  { path: '/events/', label: 'Events' },
  { path: '/branches/', label: 'Branches' },
  { path: '/campaigns/', label: 'Campaigns' },
  { path: '/learn/', label: 'Learn' },
  { path: '/member-resources/', label: 'Members' },
];
const here = currentPath(Astro.url);
const isActive = (p: string) => here.startsWith(p);
---
<header class="sticky top-0 z-50 bg-black/95 backdrop-blur text-white border-b border-white/10" id="site-header">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={href('/')} class="flex items-center gap-3 font-display font-bold tracking-tight hover:text-red-2 transition-colors">
        <Image src={badge} alt="" width={96} height={96} loading="eager" class="w-12 h-12" />
        <span class="hidden lg:inline text-base">{site.orgName}</span>
        <span class="lg:hidden text-base">{site.orgNameShort}</span>
      </a>

      <nav class="hidden md:flex items-center gap-4 lg:gap-6 text-sm font-medium" aria-label="Primary">
        {links.map((l) => (
          <a href={href(l.path)} aria-current={isActive(l.path) ? 'page' : undefined}
             class:list={['py-1 border-b-2 transition-colors hover:text-red-2', isActive(l.path) ? 'border-red text-white' : 'border-transparent']}>{l.label}</a>
        ))}
        <a href={href('/new-members/')} class="px-4 py-2 bg-red hover:bg-red-dark rounded-md font-semibold whitespace-nowrap transition-colors">Join us</a>
      </nav>

      <button id="menu-btn" class="md:hidden p-2 -mr-2 rounded-md hover:bg-white/10 transition-colors" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path class="icon-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          <path class="icon-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="md:hidden hidden border-t border-white/10" aria-label="Primary mobile">
    <div class="px-4 py-4 flex flex-col gap-1 text-base font-medium">
      {links.map((l) => (
        <a href={href(l.path)} aria-current={isActive(l.path) ? 'page' : undefined}
           class:list={['px-3 py-2.5 rounded-md hover:bg-white/10 transition-colors', isActive(l.path) && 'bg-white/10']}>{l.label}</a>
      ))}
      <a href={href('/new-members/')} class="mt-2 px-4 py-3 bg-red hover:bg-red-dark rounded-md font-semibold text-center transition-colors">New here? Join us</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('.icon-open');
  const closeIcon = btn?.querySelector('.icon-close');

  function setOpen(open: boolean) {
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu?.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  }

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
