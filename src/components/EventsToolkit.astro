---
// The bottom of the events pages: subscribe, suggest an event, print the month,
// and RSVP on Solidarity Tech, as one "your calendar, your way" section.
import SectionHeading from './SectionHeading.astro';
import CalendarSubscribe from './CalendarSubscribe.astro';
import SuggestEvent from './SuggestEvent.astro';
import UiIcon from './UiIcon.astro';
import site from '../data/site.json';
import { printMonths } from '../lib/calendar';
import { href } from '../lib/paths';
import type { Lang } from '../lib/i18n';

interface Props { lang?: Lang; now?: Date }
const { lang = 'en', now = new Date() } = Astro.props;
const es = lang === 'es';
const t = es
  ? {
      eyebrow: 'Tu calendario', title: 'Nunca te pierdas una reunión.',
      lede: 'Suscríbete, imprime el mes para tu mesa informativa o sugiere algo nuevo.',
      print: 'Imprime el mes', printBody: 'Un calendario de una página con código QR, para mesas informativas, reuniones y tableros de anuncios. Se actualiza cada mañana. Está en inglés.',
      rsvp: 'Confirma tu asistencia', rsvpBody: 'Cada evento lleva a su página en nuestro calendario de Solidarity Tech (en inglés), donde puedes confirmar tu asistencia y recibir enlaces de Zoom.', open: 'Abrir el calendario',
    }
  : {
      eyebrow: 'Your calendar', title: 'Never miss a meeting.',
      lede: 'Subscribe, print the month for your table, or suggest something new.',
      print: 'Print the month', printBody: 'A one-page calendar with a QR code, for tables, meetings, and bulletin boards. It updates every morning.',
      rsvp: 'RSVP and full details', rsvpBody: 'Each event links to its page on our Solidarity Tech calendar, where you can RSVP and get Zoom links.', open: 'Open the full calendar',
    };
---
<section class="py-14 sm:py-20 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} lede={t.lede} />
    <div class="mt-8 grid md:grid-cols-3 gap-4">
      <div class="md:col-span-3 rounded-2xl bg-mist p-1.5"><div class="rounded-xl bg-white"><CalendarSubscribe lang={lang} /></div></div>
      <SuggestEvent lang={lang} />
      <div class="h-full rounded-2xl bg-white ring-1 ring-black/10 shadow-sm p-6 flex flex-col">
        <span class="w-11 h-11 rounded-full bg-black text-white flex items-center justify-center"><UiIcon name="document" /></span>
        <h3 class="mt-4 font-display font-extrabold text-xl">{t.print}</h3>
        <p class="mt-2 text-sm text-black-2 leading-relaxed">{t.printBody}</p>
        <p class="mt-auto pt-5 flex flex-wrap gap-2">
          {printMonths(now).map((m) => (
            <a href={href(`/events/print/${m.key}/`)} hreflang={es ? 'en' : undefined} class="inline-flex items-center px-4 py-2.5 rounded-md bg-white ring-1 ring-black/15 hover:ring-red-dark hover:text-red-dark font-semibold text-sm transition-colors">{m.label}</a>
          ))}
        </p>
      </div>
      <div class="h-full rounded-2xl bg-black text-white p-6 flex flex-col">
        <span class="w-11 h-11 rounded-full bg-white text-black flex items-center justify-center"><UiIcon name="check" /></span>
        <h3 class="mt-4 font-display font-extrabold text-xl">{t.rsvp}</h3>
        <p class="mt-2 text-sm text-white/75 leading-relaxed">{t.rsvpBody}</p>
        <p class="mt-auto pt-5"><a href={site.links.fullCalendar} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-black hover:bg-red-dark hover:text-white font-semibold rounded-md transition-colors">{t.open} ↗</a></p>
      </div>
    </div>
  </div>
</section>
