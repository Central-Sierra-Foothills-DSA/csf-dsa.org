---
import type { CollectionEntry } from 'astro:content';
import { upcomingEvents, matches, typeOf, formatLongDate, formatTime } from '../lib/events';
import { href } from '../lib/paths';

interface Props {
  branch: CollectionEntry<'branches'>;
  number?: number;
}
const { branch, number } = Astro.props;
const b = branch.data;
const next = upcomingEvents().find((e) => typeOf(e) === 'meeting' && matches(e, { keywords: b.keywords }));
---
<article class="relative bg-white rounded-xl p-6 sm:p-7 border-t-4 border-red ring-1 ring-black/10 shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-display font-extrabold text-2xl leading-tight">
        <a href={href(`/branches/${branch.id}/`)} class="after:absolute after:inset-0 hover:text-red-dark">{b.name}</a>
      </h3>
      <p class="text-sm text-black-2 mt-1">{b.area}</p>
    </div>
    {number && <span class="shrink-0 w-9 h-9 rounded-full bg-red text-white font-display font-black flex items-center justify-center" aria-hidden="true">{number}</span>}
  </div>
  <dl class="mt-5 space-y-3 text-sm">
    <div class="flex gap-3">
      <dt class="w-14 shrink-0 font-semibold text-black-2">Meets</dt>
      <dd>{b.meets}</dd>
    </div>
    <div class="flex gap-3">
      <dt class="w-14 shrink-0 font-semibold text-black-2">Where</dt>
      <dd>{b.venue}</dd>
    </div>
  </dl>
  <div class="mt-5 pt-5 border-t border-black/10 flex items-center justify-between gap-3 text-sm font-semibold">
    {next ? (
      <span class="inline-flex items-center gap-2 text-red-dark">
        <span class="inline-block w-2 h-2 rounded-full bg-red" aria-hidden="true"></span>
        Next: {formatLongDate(next.start)}, {formatTime(next.start)}
      </span>
    ) : (
      <span class="text-black-2">Next date on the calendar soon</span>
    )}
    <span class="text-red-dark" aria-hidden="true">Branch page →</span>
  </div>
</article>
