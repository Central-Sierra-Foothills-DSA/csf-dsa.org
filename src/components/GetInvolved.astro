---
import config from '../data/site-config.json';
---
<section id="get-involved" class="py-20 sm:py-28 bg-charcoal text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-dsa-red font-semibold tracking-widest uppercase text-sm mb-3">Take Action</p>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl">Get Involved</h2>
      <p class="mt-4 text-lg text-white/60 max-w-2xl mx-auto">
        Whether you're a seasoned organizer or just curious about democratic socialism, there's a place for you here.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Join DSA -->
      <div class="bg-white/5 border border-white/10 rounded-xl p-8 text-center">
        <div class="w-14 h-14 bg-dsa-red/20 rounded-lg flex items-center justify-center mx-auto mb-5">
          <svg class="w-7 h-7 text-dsa-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
          </svg>
        </div>
        <h3 class="font-heading font-semibold text-xl mb-3">Join DSA</h3>
        <p class="text-white/60 text-sm leading-relaxed mb-6">
          Become a member of Democratic Socialists of America. Our chapter covers Placer, El Dorado, Nevada, and Sierra counties.
        </p>
        <a
          href={config.joinDsaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-3 bg-dsa-red hover:bg-dsa-red-dark rounded-lg font-semibold transition-colors text-sm"
        >
          Join at dsausa.org
        </a>
      </div>

      <!-- Interest Form / Mailing List -->
      <div class="bg-white/5 border border-white/10 rounded-xl p-8 text-center">
        <div class="w-14 h-14 bg-dsa-red/20 rounded-lg flex items-center justify-center mx-auto mb-5">
          <svg class="w-7 h-7 text-dsa-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>
        <h3 class="font-heading font-semibold text-xl mb-3">Stay Connected</h3>
        <p class="text-white/60 text-sm leading-relaxed mb-6">
          Sign up for our mailing list or fill out our interest form. We'll keep you in the loop on meetings, actions, and events.
        </p>
        {config.mailingListUrl ? (
          <a
            href={config.mailingListUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 bg-dsa-red hover:bg-dsa-red-dark rounded-lg font-semibold transition-colors text-sm"
          >
            Sign Up
          </a>
        ) : config.interestFormUrl ? (
          <a
            href={config.interestFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 bg-dsa-red hover:bg-dsa-red-dark rounded-lg font-semibold transition-colors text-sm"
          >
            Interest Form
          </a>
        ) : (
          <span class="inline-block px-6 py-3 bg-white/10 rounded-lg font-semibold text-sm text-white/40 cursor-default">
            Coming Soon
          </span>
        )}
      </div>

      <!-- Social Media -->
      <div class="bg-white/5 border border-white/10 rounded-xl p-8 text-center">
        <div class="w-14 h-14 bg-dsa-red/20 rounded-lg flex items-center justify-center mx-auto mb-5">
          <svg class="w-7 h-7 text-dsa-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
          </svg>
        </div>
        <h3 class="font-heading font-semibold text-xl mb-3">Follow Us</h3>
        <p class="text-white/60 text-sm leading-relaxed mb-6">
          Follow us on social media for news, event updates, and political education content.
        </p>
        <div class="flex justify-center gap-4">
          {config.social.instagram && (
            <a
              href={config.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-5 py-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors text-sm font-medium"
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              Instagram
            </a>
          )}
          {config.social.facebook && (
            <a
              href={config.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-5 py-3 bg-white/10 hover:bg-white/20 rounded-lg transition-colors text-sm font-medium"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385h-3.047v-3.47h3.047v-2.642c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.514c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385c5.738-.9 10.126-5.864 10.126-11.854z"/></svg>
              Facebook
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
