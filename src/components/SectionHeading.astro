---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
}
const { eyebrow, title, lede, align = 'left', tone = 'light' } = Astro.props;
const center = align === 'center';
const dark = tone === 'dark';
---
<div class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  <p class="flex items-center gap-2 text-red font-semibold tracking-[0.18em] uppercase text-xs sm:text-sm mb-3" class:list={[center && 'justify-center']}>
    <span class="inline-block w-6 h-[2px] bg-red" aria-hidden="true"></span>{eyebrow}
  </p>
  <h2 class:list={['font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl leading-[1.05]', dark ? 'text-cream' : 'text-ink']}>{title}</h2>
  {lede && <p class:list={['mt-4 text-lg leading-relaxed', dark ? 'text-cream/70' : 'text-stone']}>{lede}</p>}
</div>
