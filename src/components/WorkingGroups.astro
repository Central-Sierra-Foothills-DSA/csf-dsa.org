---
import groups from '../data/working-groups.json';

const icons: Record<string, string> = {
  ballot: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  hands: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`,
  fist: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" /></svg>`,
  book: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>`,
};
---
<section id="working-groups" class="py-20 sm:py-28 bg-warm-gray">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-dsa-red font-semibold tracking-widest uppercase text-sm mb-3">Our Work</p>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl">Working Groups</h2>
      <p class="mt-4 text-lg text-charcoal/60 max-w-2xl mx-auto">
        Our chapter organizes through working groups — focused teams that drive campaigns and projects in areas that matter to our community.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {groups.map((group) => (
        <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow border border-charcoal/5">
          <div class="w-14 h-14 bg-dsa-red-light rounded-lg flex items-center justify-center text-dsa-red mb-4">
            <Fragment set:html={icons[group.icon] || icons.ballot} />
          </div>
          <h3 class="font-heading font-semibold text-lg mb-2">{group.name}</h3>
          <p class="text-sm text-charcoal/60 leading-relaxed">{group.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
