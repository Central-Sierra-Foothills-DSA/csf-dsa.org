---
// "Add our events to your calendar": subscribe links for a calendar feed.
// A subscription keeps updating; the download is a one-time copy.
// With no `feed`, it offers the whole chapter calendar (/events.ics) plus a list of
// smaller feeds (one branch, one kind of event). With `feed` (a slug from getFeeds()
// in src/lib/calendar.ts), it offers just that one, as on branch pages.
import UiIcon from './UiIcon.astro';
import { href } from '../lib/paths';
import { getFeeds, subscribeLinks } from '../lib/calendar';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  feed?: string;
  /** Stack the text above the buttons at every width (for narrow sidebars). */
  stack?: boolean;
}
const { lang = 'en', feed, stack = false } = Astro.props;
const es = lang === 'es';

const feeds = await getFeeds();
const one = feed ? feeds.find((f) => f.slug === feed) : undefined;
if (feed && !one) throw new Error(`CalendarSubscribe: no calendar feed called "${feed}". See getFeeds() in src/lib/calendar.ts.`);
const path = one ? `/calendar/${one.slug}.ics` : '/events.ics';
const links = subscribeLinks(href(path), Astro.site);
const name = one ? (es ? one.nameEs : one.name) : '';

const t = es
  ? {
      title: one ? `Agrega los eventos de ${name} a tu calendario` : 'Agrega nuestros eventos a tu calendario',
      body: one ? 'Suscríbete una vez y los eventos de esta rama aparecerán solos en tu calendario, con las actualizaciones.' : 'Suscríbete una vez y los eventos del capítulo aparecerán solos en tu calendario, con las actualizaciones.',
      google: 'Google Calendar', apple: 'Apple o Outlook', download: 'Descargar (.ics)',
      more: '¿Solo una rama o un tipo de evento?', moreBody: 'Suscríbete a un calendario más pequeño:', branches: 'Ramas', kinds: 'Tipos de evento',
    }
  : {
      title: one ? `Add ${name} events to your calendar` : 'Add our events to your calendar',
      body: one ? 'Subscribe once and this branch’s events show up in your own calendar, and stay up to date.' : 'Subscribe once and chapter events show up in your own calendar, and stay up to date.',
      google: 'Google Calendar', apple: 'Apple or Outlook', download: 'Download (.ics)',
      more: 'Just one branch, or one kind of event?', moreBody: 'Subscribe to a smaller calendar instead:', branches: 'Branches', kinds: 'Kinds of event',
    };
const btn = 'inline-flex items-center gap-2 px-4 py-2.5 rounded-md bg-white ring-1 ring-black/15 hover:ring-red-dark hover:text-red-dark font-semibold text-sm transition-colors';
const mini = 'px-2 py-1 rounded-md ring-1 ring-black/15 hover:ring-red-dark hover:text-red-dark text-xs font-semibold';
const groups = [
  { label: t.branches, items: feeds.filter((f) => f.kind === 'branch') },
  { label: t.kinds, items: feeds.filter((f) => f.kind === 'type') },
];
---
<div class="rounded-xl ring-1 ring-black/10 p-6">
  <div class:list={[!stack && 'sm:flex sm:items-center sm:gap-6']}>
    <div class="flex-1">
      <h2 class="flex items-center gap-2 font-display font-bold text-lg"><UiIcon name="calendar" class="w-5 h-5 text-red-dark shrink-0" /> {t.title}</h2>
      <p class="text-sm text-black-2 mt-1">{t.body}</p>
    </div>
    <div class:list={['mt-4 flex flex-wrap gap-2 shrink-0', !stack && 'sm:mt-0']}>
      <a href={links.google} target="_blank" rel="noopener" class={btn}>{t.google} ↗</a>
      <a href={links.webcal} class={btn}>{t.apple}</a>
      <a href={href(path)} download={one ? `csf-dsa-${one.slug}.ics` : 'csf-dsa-events.ics'} class={btn}>{t.download}</a>
    </div>
  </div>

  {!one && (
    <details class="feeds mt-5 border-t border-black/10 pt-4">
      <summary class="cursor-pointer font-semibold text-sm text-red-dark hover:text-red w-fit">{t.more}</summary>
      <p class="mt-3 text-sm text-black-2">{t.moreBody}</p>
      <div class="mt-3 grid sm:grid-cols-2 gap-x-8 gap-y-5">
        {groups.map((g) => (
          <div>
            <p class="text-xs font-semibold tracking-[0.16em] uppercase text-black-2">{g.label}</p>
            <ul class="mt-2 divide-y divide-black/10">
              {g.items.map((f) => {
                const l = subscribeLinks(href(`/calendar/${f.slug}.ics`), Astro.site);
                return (
                  <li class="flex items-center justify-between gap-3 py-2">
                    <span class="text-sm font-semibold">{es ? f.nameEs : f.name}</span>
                    <span class="flex gap-1.5 shrink-0">
                      <a href={l.google} target="_blank" rel="noopener" class={mini} aria-label={`${es ? f.nameEs : f.name}: Google Calendar`}>Google ↗</a>
                      <a href={l.webcal} class={mini} aria-label={`${es ? f.nameEs : f.name}: ${t.apple}`}>Apple/Outlook</a>
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </details>
  )}
</div>
