---
// A section that folds away on phones and is always open from 768px up.
// On a phone it shows a tap-to-open bar; tapping shows the content. Works
// without JavaScript (a hidden checkbox and CSS), so nothing is lost if
// scripts are off.
//
//   <Fold id="glossary-ideas" label="The big ideas" hint="5 words">…</Fold>
interface Props {
  /** Unique on the page. */
  id: string;
  /** What the bar says on a phone. */
  label: string;
  /** Small text after the label, like "5 words". */
  hint?: string;
  /** Bar colors: light (default) or dark backgrounds. */
  tone?: 'light' | 'dark';
}
const { id, label, hint, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<div class="fold">
  <input type="checkbox" id={id} class="fold-toggle peer sr-only" />
  <label for={id} class:list={[
    'md:hidden flex items-center gap-3 w-full rounded-xl px-5 py-4 cursor-pointer select-none font-display font-bold text-lg leading-snug',
    'peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-red-dark',
    dark ? 'bg-white/10 ring-1 ring-white/15 text-white' : 'bg-mist text-black',
  ]}>
    <span class="flex-1">{label}{hint && <span class:list={['ml-2 text-sm font-semibold', dark ? 'text-white/60' : 'text-black-2']}>{hint}</span>}</span>
    <svg class="fold-chevron w-5 h-5 shrink-0 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" /></svg>
  </label>
  <div class="fold-body hidden peer-checked:block md:block">
    <slot />
  </div>
</div>

<style>
  .fold-toggle:checked + label .fold-chevron { transform: rotate(180deg); }
  @media (max-width: 767px) {
    .fold-toggle:checked ~ .fold-body { margin-top: 0.75rem; }
  }
</style>
