---
// Landscape table sign. Sizes in cqw (percent of the sign's width).
import { Image } from 'astro:assets';
import QR from '../../QR.astro';
import site from '../../../data/site.json';
import { displayUrl } from '../../../lib/member-guide';
import { printablesText } from '../../../lib/printables';
import badgeWhite from '../../../assets/logos/csf-dsa-white.png';

const t = printablesText.ready.tableSign;
const joinUrl = site.links.joinChapterForm;
const instagram = displayUrl(site.social.instagram).replace(/^instagram\.com\//, '@');
---
<article class="@container w-full h-full bg-red text-white flex overflow-hidden">
  <div class="flex-1 flex flex-col justify-between p-[5cqw]">
    <div class="flex items-center gap-[2cqw]">
      <Image loading="eager" src={badgeWhite} alt="" width={240} height={240} class="w-[8cqw] h-[8cqw]" />
      <p class="font-display font-bold text-[2.6cqw] leading-[1.1]">Central Sierra<br />Foothills DSA</p>
    </div>
    <div>
      <h1 class="font-display font-black text-[10.5cqw] leading-[0.92] tracking-[-0.01em]">{t.headline}</h1>
      <div class="mt-[2.5cqw] h-[0.9cqw] w-[12cqw] bg-white"></div>
      <p class="mt-[2.5cqw] text-[2.9cqw] leading-[1.3] text-white/90 max-w-[52cqw]">{t.sub}</p>
    </div>
    <p class="text-[1.9cqw] font-semibold text-white/85">Democratic Socialists of America · Instagram {instagram}</p>
  </div>
  <div class="w-[32cqw] shrink-0 bg-white text-black flex flex-col items-center justify-center p-[3.5cqw] text-center">
    <QR url={joinUrl} class="w-[23cqw] h-[23cqw]" />
    <p class="mt-[2.5cqw] font-display font-extrabold text-[3.2cqw] leading-[1.05]">{t.cta}</p>
    <p class="mt-[0.8cqw] font-bold text-[2.1cqw] text-red-dark">{displayUrl(joinUrl)}</p>
  </div>
</article>
