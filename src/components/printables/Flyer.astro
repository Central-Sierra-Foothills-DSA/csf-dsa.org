---
// One printed flyer. It fills its parent box and scales with it (sizes are in
// cqw, percent of the flyer's width), so the same design works as a poster, a
// half-page flyer, and a quarter-page handbill.
//
// Top: a bold color block with an angled edge. Red with the Foresthill Bridge
// photo for recruiting and event flyers; black with a line icon for hangouts.
//
// Elements with data-field become fill-in boxes: `npm run printables` measures
// them in the browser and adds PDF form fields on top with pdf-lib.
import { Image } from 'astro:assets';
import QR from '../QR.astro';
import Icon from './Icon.astro';
import site from '../../data/site.json';
import { displayUrl } from '../../lib/member-guide';
import { printablesText, type Design } from '../../lib/printables';
import badgeWhite from '../../assets/logos/csf-dsa-white.png';
// Pre-tinted with scripts/make-red-photo.mjs (CSS filters would bloat the PDFs).
import bridge from '../../assets/photos/foresthill-bridge-red.jpg';

interface Props {
  design: Design;
  /** Fill-in boxes to show, with their character limits (per line for the note). */
  fields: Partial<Record<'when' | 'where' | 'note', number>>;
  /** Taller-than-letter shape (half-page): the color block fills half the height. */
  tall?: boolean;
}
const { design, fields, tall = false } = Astro.props;
const { fieldBox } = printablesText;
const instagram = displayUrl(site.social.instagram).replace(/^instagram\.com\//, '@');
const facebook = displayUrl(site.social.facebook);
const line = 'border-b-[0.25cqw] border-black-3';
// Ready-made flyers have no fill-in box, so the QR code gets the room.
const ready = Object.keys(fields).length === 0;
const dark = design.tone === 'black';
---
<article class="flyer @container w-full h-full bg-white text-black flex flex-col overflow-hidden">
  <header class:list={['hero shrink-0 relative flex flex-col', tall && 'min-h-[50%]', ' text-white overflow-hidden px-[6cqw] pt-[4cqw] pb-[8cqw]', dark ? 'bg-black' : 'bg-red']}>
    {dark ? (
      <>
        <svg class="absolute right-0 top-0 h-full w-[60%] opacity-40" aria-hidden="true"><defs><pattern id="dots" width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="8" cy="8" r="1.6" fill="#ec1f27" /></pattern></defs><rect width="100%" height="100%" fill="url(#dots)" /></svg>
        {design.icon && <Icon name={design.icon} class="absolute right-[5cqw] top-[3.5cqw] w-[26cqw] h-[26cqw] text-white" />}
      </>
    ) : (
      <>
        <Image loading="eager" src={bridge} alt="" format="jpg" quality={70} widths={[1000]} sizes="8.5in" class="absolute inset-0 w-full h-full object-cover object-top" />
        <div class="absolute inset-0 bg-gradient-to-t from-red via-red/40 to-transparent" aria-hidden="true"></div>
      </>
    )}
    <div class="relative flex items-center gap-[2.5cqw]">
      <Image loading="eager" src={badgeWhite} alt="" width={240} height={240} class="w-[8cqw] h-[8cqw]" />
      <p class="font-display font-bold text-[3.2cqw] leading-[1.1]">Central Sierra<br />Foothills DSA</p>
    </div>
    <div class:list={['relative mt-auto', dark && design.icon ? 'pt-[11cqw]' : 'pt-[6cqw]']}>
      <p class:list={['inline-block rounded-full px-[2.4cqw] py-[0.7cqw] font-bold uppercase tracking-[0.14em] text-[2.4cqw]', dark ? 'bg-red text-white' : 'bg-white text-red-dark']}>{design.eyebrow}</p>
      <h1 class:list={['mt-[2cqw] font-display font-black leading-[0.92] tracking-[-0.015em]', ready ? 'text-[12cqw]' : 'text-[9.6cqw]']}>{design.headline}</h1>
    </div>
  </header>

  <div class="flex-1 flex flex-col px-[6cqw] pt-[1cqw] pb-[2.4cqw]">
    <p class:list={['leading-[1.36] text-black-1', ready ? 'text-[3.9cqw]' : 'text-[3.3cqw]']}>{design.body}</p>
    {design.meets && (
      <p class="mt-[1.4cqw] text-[3.3cqw] leading-[1.36]">
        <span class="font-bold">{design.meets.label}:</span> {design.meets.text}
      </p>
    )}

    <div class="flex-1"></div>

    {ready ? (
      <div class="mt-[3cqw] flex items-center gap-[5cqw]">
        <div class="shrink-0 bg-white ring-[0.5cqw] ring-black rounded-[2cqw] p-[2cqw]">
          <QR url={design.qrUrl} class="w-[28cqw] h-[28cqw]" />
        </div>
        <div>
          <p class="font-display font-black text-[6.4cqw] leading-[1]">{design.cta}</p>
          <p class="mt-[1.5cqw] font-bold text-[4cqw] text-red-dark">{design.qrLabel}</p>
        </div>
      </div>
    ) : (
      <div class="mt-[3.5cqw] flex gap-[3cqw] items-stretch">
        <section class="ticket relative flex-1 min-w-0 rounded-[2cqw] border-[0.5cqw] border-black px-[3.5cqw] pt-[3.2cqw] pb-[2.4cqw]">
          <p class:list={['absolute -top-[2.3cqw] left-[3cqw] rounded-full px-[2.4cqw] py-[0.6cqw] font-bold uppercase tracking-[0.14em] text-[2.3cqw] text-white', dark ? 'bg-red' : 'bg-black']}>{design.fieldTitle ?? fieldBox.title}</p>
          <dl>
            {(['when', 'where'] as const).filter((k) => fields[k]).map((k) => (
              <div class="flex items-end gap-[2cqw] mt-[0.6cqw]">
                <dt class="w-[9.5cqw] shrink-0 font-display font-extrabold text-[3cqw] pb-[0.6cqw]">{fieldBox.labels[k]}</dt>
                <dd class:list={['flex-1 h-[6cqw]', line]} data-field={k} data-max={fields[k]}></dd>
              </div>
            ))}
            {fields.note && (
              <div class="flex items-start gap-[2cqw] mt-[0.6cqw]">
                <dt class="w-[9.5cqw] shrink-0 font-display font-extrabold text-[3cqw] pt-[2.6cqw]">{fieldBox.labels.note}</dt>
                <dd class="flex-1">
                  <div class:list={['h-[6cqw]', line]} data-field="note-1" data-max={fields.note}></div>
                  <div class:list={['h-[6cqw]', line]} data-field="note-2" data-max={fields.note}></div>
                </dd>
              </div>
            )}
          </dl>
        </section>

        <div class="w-[25cqw] shrink-0 flex flex-col justify-center">
          <div class="bg-white ring-[0.5cqw] ring-black rounded-[1.5cqw] p-[1.5cqw]">
            <QR url={design.qrUrl} class="w-full h-auto aspect-square" />
          </div>
          <p class="mt-[1.6cqw] font-display font-extrabold text-[3.3cqw] leading-[1.1]">{design.cta}</p>
          <p class="mt-[0.6cqw] font-bold text-[2.5cqw] leading-[1.2] text-red-dark">{design.qrLabel}</p>
        </div>
      </div>
    )}

    <footer class="mt-[2.2cqw] pt-[1.8cqw] border-t-[0.25cqw] border-black-4 flex flex-wrap justify-between gap-x-[3cqw] text-[2.4cqw] text-black-2">
      <span>Instagram <span class="font-semibold text-black">{instagram}</span></span>
      <span class="font-semibold text-black">{facebook}</span>
      <span class="font-semibold text-black">{site.contactEmail}</span>
    </footer>
  </div>
</article>

<style>
  /* Angled bottom edge on the color block. */
  .hero { clip-path: polygon(0 0, 100% 0, 100% 84%, 0 100%); }
</style>
