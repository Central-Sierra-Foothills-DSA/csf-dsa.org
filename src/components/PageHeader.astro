---
// The red title band at the top of every inner page.
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Optional breadcrumb back to a parent page. */
  back?: { href: string; label: string };
}
const { eyebrow, title, lede, back } = Astro.props;
---
<section class="bg-red-dark text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-12 sm:pt-16 sm:pb-16">
    {back && (
      <a href={back.href} class="inline-flex items-center gap-1.5 text-sm font-semibold text-white hover:underline underline-offset-4 mb-5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5 5-5M18 12H6" /></svg>
        {back.label}
      </a>
    )}
    {eyebrow && <p class="font-bold tracking-[0.18em] uppercase text-xs sm:text-sm mb-3">{eyebrow}</p>}
    <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl leading-[1.02] max-w-4xl">{title}</h1>
    {lede && <p class="mt-5 text-lg sm:text-xl leading-relaxed max-w-2xl">{lede}</p>}
    <slot />
  </div>
</section>
