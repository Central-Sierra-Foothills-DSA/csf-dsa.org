---
import config from '../data/site-config.json';
const hasCalendar = !!config.calendarEmbedUrl;
---
<section id="calendar" class="py-20 sm:py-28 bg-warm-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <p class="text-dsa-red font-semibold tracking-widest uppercase text-sm mb-3">Events</p>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl">Upcoming Events</h2>
      <p class="mt-4 text-lg text-charcoal/60 max-w-2xl mx-auto">
        Join us at our next meeting, action, or social event. Everyone is welcome.
      </p>
    </div>

    {hasCalendar ? (
      <div class="rounded-xl overflow-hidden shadow-sm border border-charcoal/5 bg-white">
        <iframe
          src={config.calendarEmbedUrl}
          class="w-full h-[500px] sm:h-[600px]"
          frameborder="0"
          scrolling="no"
          title="Chapter Events Calendar"
        ></iframe>
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-charcoal/5 p-12 text-center">
        <div class="w-16 h-16 bg-warm-gray rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-charcoal/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
        </div>
        <p class="text-charcoal/60 text-lg mb-2">Calendar coming soon</p>
        <p class="text-charcoal/40 text-sm">Check our social media for the latest events and meeting times.</p>
      </div>
    )}
  </div>
</section>
