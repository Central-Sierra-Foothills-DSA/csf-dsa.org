---
import site from '../data/site.json';
import SectionHeading from './SectionHeading.astro';
import { upcomingEvents, groupByDay, formatTimeRange, shortLocation, isVirtual, eventsFetchedAt } from '../lib/events';

const now = new Date();
const upcoming = upcomingEvents(now, 6);
const days = groupByDay(upcoming);
const updated = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', month: 'short', day: 'numeric' }).format(new Date(eventsFetchedAt));
---
<section id="events" class="py-20 sm:py-28 bg-mist">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <SectionHeading eyebrow="Upcoming events" title="Come to a meeting. Everyone is welcome." lede="Branch meetings, campaign work, city council actions, and socials across the foothills. You don't have to be a member to show up." />
      <a href={site.links.fullCalendar} target="_blank" rel="noopener" class="shrink-0 inline-flex items-center gap-2 px-5 py-3 bg-black hover:bg-black-1 text-white font-semibold rounded-md transition-colors">
        Full calendar &amp; RSVP
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9" /></svg>
      </a>
    </div>

    {days.length === 0 ? (
      <div class="mt-12 bg-white rounded-xl p-10 text-center ring-1 ring-black/5">
        <p class="text-lg font-semibold">Nothing on the calendar right now.</p>
        <p class="mt-2 text-black-2">Check the full calendar or follow us on social media for the next meeting.</p>
      </div>
    ) : (
      <ol class="mt-12 divide-y divide-black/10 border-y border-black/10">
        {days.map((day) => (
          <li class="grid grid-cols-[4.5rem_1fr] sm:grid-cols-[6rem_1fr] gap-4 sm:gap-8 py-6">
            <div class="text-center sm:text-left">
              <div class="text-xs font-semibold tracking-[0.18em] uppercase text-red">{day.weekday}</div>
              <div class="font-display font-black text-4xl sm:text-5xl leading-none mt-1">{day.day}</div>
              <div class="text-sm text-black-2 mt-1">{day.month}</div>
            </div>
            <ul class="space-y-5">
              {day.events.map((e) => (
                <li>
                  <div class="text-sm font-medium text-black-2 tabular-nums">{formatTimeRange(e)}</div>
                  <h3 class="font-display font-bold text-xl sm:text-2xl leading-tight mt-0.5">
                    {e.url ? (
                      <a href={e.url} target="_blank" rel="noopener" class="hover:text-red-dark underline-offset-4 decoration-2 decoration-red/0 hover:decoration-red/60 hover:underline transition-colors">{e.title}</a>
                    ) : e.title}
                  </h3>
                  {shortLocation(e) && (
                    <p class="mt-1.5 flex items-center gap-1.5 text-sm text-black-2">
                      {isVirtual(e) ? (
                        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" /></svg>
                      ) : (
                        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                      )}
                      <span>{shortLocation(e)}</span>
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    )}

    <p class="mt-6 text-xs text-black-2">
      Times are Pacific. Event details and RSVPs live on our Solidarity Tech calendar; this list refreshes automatically each day (last synced {updated}).
    </p>
  </div>
</section>
