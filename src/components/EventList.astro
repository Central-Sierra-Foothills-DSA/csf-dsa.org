---
// A scannable list of events grouped by day. Used on the home page, the events
// page, and branch and campaign pages.
import AddToCalendar from './AddToCalendar.astro';
import { type ChapterEvent, type Lang, groupByDay, formatTimeRange, shortLocation, isVirtual, typeOf, typeLabel, eventSummary } from '../lib/events';

interface Props {
  events: ChapterEvent[];
  /** Shown when there are no events. */
  empty?: string;
  /** Smaller date column and titles, for sidebars and inner pages. */
  compact?: boolean;
  /** Dates, times, and type labels in this language. Titles stay as the calendar has them. */
  lang?: Lang;
  /** Show a one- or two-line summary from the event's description. */
  summaries?: boolean;
  /** Show the "Add to calendar" menu on each event. On by default except in compact lists. */
  calendar?: boolean;
  /** Extra data attributes for each event (used by the events page filters). */
  attrs?: (e: ChapterEvent) => Record<string, string>;
  /** Give each day an id (prefix + YYYY-MM-DD) so the month view can link to it. */
  dayIds?: string;
}
const { events, empty = 'Nothing on the calendar right now.', compact = false, lang = 'en', summaries = !compact, calendar = !compact, attrs, dayIds } = Astro.props;
const days = groupByDay(events, lang);

const chip: Record<string, string> = {
  action: 'bg-red-dark text-white',
  social: 'bg-red-4 text-red-dark',
  meeting: 'bg-black text-white',
  civic: 'bg-black-4/50 text-black',
  training: 'bg-black-4/50 text-black',
  other: 'bg-black-4/50 text-black',
};
---
{days.length === 0 ? (
  <div class="bg-white rounded-xl p-8 text-center ring-1 ring-black/10">
    <p class="font-semibold">{empty}</p>
  </div>
) : (
  <ol class="divide-y divide-black/10 border-y border-black/10">
    {days.map((day) => (
      <li id={dayIds ? `${dayIds}${day.key}` : undefined} class:list={['event-day scroll-mt-24 grid gap-4 sm:gap-8', compact ? 'grid-cols-[3.5rem_1fr] py-4' : 'grid-cols-[4.5rem_1fr] sm:grid-cols-[6rem_1fr] py-6']}>
        <div class="text-center sm:text-left">
          <div class="text-xs font-semibold tracking-[0.18em] uppercase text-red-dark">{day.weekday}</div>
          <div class:list={['font-display font-black leading-none mt-1', compact ? 'text-3xl' : 'text-4xl sm:text-5xl']}>{day.day}</div>
          <div class="text-sm text-black-2 mt-1">{day.month}</div>
        </div>
        <ul class:list={[compact ? 'space-y-4' : 'space-y-5']}>
          {day.events.map((e) => (
            <li class="event" data-type={typeOf(e)} {...(attrs ? attrs(e) : {})}>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="text-sm font-medium text-black-2 tabular-nums">{formatTimeRange(e, lang)}</span>
                <span class:list={['text-[0.7rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded-sm', chip[typeOf(e)]]}>{typeLabel(e, lang)}</span>
              </div>
              <h3 class:list={['font-display font-bold leading-tight mt-1', compact ? 'text-lg' : 'text-xl sm:text-2xl']}>
                {e.url ? (
                  <a href={e.url} target="_blank" rel="noopener" class="hover:text-red-dark underline-offset-4 decoration-2 hover:underline transition-colors">{e.title}</a>
                ) : e.title}
              </h3>
              {shortLocation(e) && (
                <p class="mt-1.5 flex items-center gap-1.5 text-sm text-black-2">
                  {isVirtual(e) ? (
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" /></svg>
                  ) : (
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                  )}
                  <span>{shortLocation(e, lang)}</span>
                </p>
              )}
              {summaries && eventSummary(e) && (
                <p class="mt-2 text-black-1 leading-relaxed max-w-2xl" lang="en">{eventSummary(e)}</p>
              )}
              {calendar && <div class="mt-3"><AddToCalendar event={e} lang={lang} /></div>}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
)}
