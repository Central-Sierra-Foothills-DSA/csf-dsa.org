---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import badge from '../assets/logos/csf-dsa-white.png';
import national from '../assets/logos/dsa-national-circle.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="bg-black text-white/75">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <a href={`${base}/`} class="inline-flex items-center gap-3">
          <Image src={badge} alt="" width={192} height={192} class="w-24 h-24" />
          <span class="font-display font-bold text-white text-lg leading-tight">{site.orgName}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed max-w-sm">
          A chapter of the Democratic Socialists of America organizing in {site.counties.slice(0, -1).join(', ')}, and {site.counties.at(-1)} counties, California.
        </p>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-xs font-semibold tracking-[0.18em] uppercase text-white/50 mb-4">On this page</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="#about" class="hover:text-red-2 transition-colors">About</a></li>
          <li><a href="#events" class="hover:text-red-2 transition-colors">Events</a></li>
          <li><a href="#branches" class="hover:text-red-2 transition-colors">Branches</a></li>
          <li><a href="#campaigns" class="hover:text-red-2 transition-colors">Campaigns</a></li>
          <li><a href="#get-involved" class="hover:text-red-2 transition-colors">Get involved</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <h3 class="text-xs font-semibold tracking-[0.18em] uppercase text-white/50 mb-4">Connect</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={site.links.joinChapterForm} target="_blank" rel="noopener" class="hover:text-red-2 transition-colors">Chapter sign-up form</a></li>
          <li><a href={site.links.fullCalendar} target="_blank" rel="noopener" class="hover:text-red-2 transition-colors">Full event calendar</a></li>
          <li><a href={`mailto:${site.contactEmail}`} class="hover:text-red-2 transition-colors">{site.contactEmail}</a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener" class="hover:text-red-2 transition-colors">Instagram</a></li>
          <li><a href={site.social.facebook} target="_blank" rel="noopener" class="hover:text-red-2 transition-colors">Facebook</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs text-white/60">
      <div class="flex items-center gap-3">
        <a href={site.links.dsaNational} target="_blank" rel="noopener" class="shrink-0">
          <Image src={national} alt="Democratic Socialists of America" width={96} height={96} class="w-12 h-12" />
        </a>
        <p>&copy; {new Date().getFullYear()} {site.orgName}. A chapter of <a href={site.links.dsaNational} target="_blank" rel="noopener" class="underline hover:text-red-2">Democratic Socialists of America</a>.</p>
      </div>
      <p>This site is open source. <a href={site.links.github} target="_blank" rel="noopener" class="underline hover:text-red-2">Improve it on GitHub</a>.</p>
    </div>
  </div>
</footer>
