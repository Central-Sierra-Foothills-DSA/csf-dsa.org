---
import site from '../data/site.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="bg-ink text-cream/75">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <a href={`${base}/`} class="inline-flex items-center gap-3">
          <img src={`${base}/images/logo.png`} alt="" width="44" height="44" class="w-11 h-11 rounded-full ring-2 ring-white/10" />
          <span class="font-display font-bold text-cream text-lg leading-tight">{site.orgName}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed max-w-sm">
          A chapter of the Democratic Socialists of America organizing in {site.counties.slice(0, -1).join(', ')}, and {site.counties.at(-1)} counties, California.
        </p>
      </div>

      <div class="md:col-span-3">
        <h3 class="text-xs font-semibold tracking-[0.18em] uppercase text-cream/50 mb-4">On this page</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="#about" class="hover:text-gold transition-colors">About</a></li>
          <li><a href="#events" class="hover:text-gold transition-colors">Events</a></li>
          <li><a href="#branches" class="hover:text-gold transition-colors">Branches</a></li>
          <li><a href="#campaigns" class="hover:text-gold transition-colors">Campaigns</a></li>
          <li><a href="#get-involved" class="hover:text-gold transition-colors">Get involved</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <h3 class="text-xs font-semibold tracking-[0.18em] uppercase text-cream/50 mb-4">Connect</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={site.links.joinChapterForm} target="_blank" rel="noopener" class="hover:text-gold transition-colors">Chapter sign-up form</a></li>
          <li><a href={site.links.fullCalendar} target="_blank" rel="noopener" class="hover:text-gold transition-colors">Full event calendar</a></li>
          <li><a href={`mailto:${site.contactEmail}`} class="hover:text-gold transition-colors">{site.contactEmail}</a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener" class="hover:text-gold transition-colors">Instagram</a></li>
          <li><a href={site.social.facebook} target="_blank" rel="noopener" class="hover:text-gold transition-colors">Facebook</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-cream/50">
      <p>&copy; {new Date().getFullYear()} {site.orgName}. A chapter of <a href={site.links.dsaNational} target="_blank" rel="noopener" class="underline hover:text-gold">Democratic Socialists of America</a>.</p>
      <p>This site is open source. <a href={site.links.github} target="_blank" rel="noopener" class="underline hover:text-gold">Improve it on GitHub</a>.</p>
    </div>
  </div>
</footer>
