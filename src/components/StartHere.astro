---
// Four clear starting points, one for each kind of visitor.
import { href } from '../lib/paths';

const cards = [
  {
    title: 'New here?',
    body: 'What DSA is, what a first meeting is like, and how to join.',
    path: '/new-members/',
    icon: 'M12 6v12m6-6H6',
  },
  {
    title: 'Find your branch',
    body: 'Four branches across the foothills. See which one meets near you.',
    path: '/branches/',
    icon: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
  },
  {
    title: 'Come to an event',
    body: 'Meetings, socials, and actions. You don’t need to be a member.',
    path: '/events/',
    icon: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5',
  },
  {
    title: 'See our campaigns',
    body: 'What members have voted to put our time and energy behind.',
    path: '/campaigns/',
    icon: 'M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46',
  },
];
---
<section class="bg-white border-b border-black/10" aria-label="Where to start">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {cards.map((c) => (
        <li>
          <a href={href(c.path)} class="group flex h-full gap-4 p-5 rounded-xl bg-mist hover:bg-red hover:text-white transition-colors">
            <span class="shrink-0 w-11 h-11 rounded-full bg-red text-white group-hover:bg-white group-hover:text-red flex items-center justify-center transition-colors" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon} /></svg>
            </span>
            <span>
              <span class="block font-display font-extrabold text-lg leading-tight">{c.title} <span aria-hidden="true">→</span></span>
              <span class="block mt-1 text-sm leading-relaxed text-black-2 group-hover:text-white">{c.body}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
