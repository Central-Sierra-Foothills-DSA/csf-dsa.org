---
// A QR code rendered to inline SVG at build time. No JavaScript ships to the browser.
import QRCode from 'qrcode';

interface Props {
  url: string;
  class?: string;
  label?: string;
}
const { url, class: className = 'w-20 h-20', label } = Astro.props;
const svg = await QRCode.toString(url, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#231f20', light: '#ffffff00' },
});
---
<span class:list={['qr inline-block shrink-0', className]} role="img" aria-label={label ?? `QR code for ${url}`} set:html={svg} />

<style>
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
</style>
